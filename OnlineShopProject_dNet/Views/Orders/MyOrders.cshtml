@model IEnumerable<OnlineShopProject_dNet.Models.Order>
@using OnlineShopProject_dNet.Models

@{
    ViewBag.Title = "Comenzile Mele";
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="fw-bold mb-1">
                <i class="bi bi-bag-check"></i> Comenzile Mele
            </h1>
            <p class="text-muted">Istoricul comenzilor tale</p>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-light border shadow-sm text-center py-5">
            <i class="bi bi-inbox fs-1 text-muted d-block mb-2"></i>
            <h5 class="text-muted">Nu ai comenzi finalizate</h5>
            <p class="text-muted small">Încearcă să cumperi ceva din magazinul nostru.</p>
            <a href="/Products/Index" class="btn btn-primary mt-3">
                <i class="bi bi-shop"></i> Înapoi la produse
            </a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var order in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-header bg-light border-bottom">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h6 class="card-title mb-0 fw-bold">
                                        <i class="bi bi-bag-check text-success"></i> Comanda #@order.Id
                                    </h6>
                                    <small class="text-muted">
                                        @order.Date.ToString("dd MMMM yyyy, HH:mm")
                                    </small>
                                </div>
                                <span class="badge bg-success">
                                    <i class="bi bi-check-circle"></i> Finalizat?
                                </span>
                            </div>
                        </div>

                        <div class="card-body">
                            @* Adresa *@
                            <div class="mb-3">
                                <small class="text-muted fw-semibold d-block mb-1">
                                    <i class="bi bi-geo-alt"></i> Adresa de livrare
                                </small>
                                <p class="mb-0 small">@order.ShippingAddress</p>
                            </div>

                            @* Numar produse *@
                            <div class="mb-3">
                                <small class="text-muted fw-semibold d-block mb-1">
                                    <i class="bi bi-box-seam"></i> Produse
                                </small>
                                <p class="mb-0 small">
                                    @(order.OrderDetails?.Count() ?? 0) produs(e)
                                </p>
                            </div>

                            @* Total *@
                            <div class="mb-3 pb-3 border-bottom">
                                <small class="text-muted fw-semibold d-block mb-1">
                                    <i class="bi bi-cash"></i> Total
                                </small>
                                <p class="mb-0">
                                    <strong class="text-success fs-5">@order.TotalAmount.ToString("0.00") RON</strong>
                                </p>
                            </div>

                            @* Buton detalii *@
                            <a href="/Orders/Details/@order.Id" class="btn btn-outline-primary btn-sm w-100">
                                <i class="bi bi-eye"></i> Vezi detalii
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .card {
        border-radius: 12px;
        overflow: hidden;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.15) !important;
    }
</style>
