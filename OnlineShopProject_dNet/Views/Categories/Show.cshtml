@model OnlineShopProject_dNet.Models.Category
@using Microsoft.AspNetCore.Identity
@using OnlineShopProject_dNet.Models

@* Injectam UserManager pentru a putea filtra produsele utilizatorului curent *@
@inject UserManager<ApplicationUser> UserManager

@{
    ViewBag.Title = "Produse în: " + Model.Name;
    var currentUserId = UserManager.GetUserId(User);
}

<div class="container mt-5">

    @* --- HEADER CATEGORIE --- *@
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <div>
            <h2 class="fw-bold m-0 text-primary">@Model.Name</h2>
            <p class="text-muted m-0">Toate produsele din această categorie</p>
        </div>

        <div class="d-flex gap-2">
            <a href="/Categories/Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Înapoi la Categorii
            </a>

            @* FIX: Butoane Admin vizibile DOAR pentru Admin *@
            @if (User.IsInRole("Admin"))
            {
                <a href="/Categories/Edit/@Model.Id" class="btn btn-warning">
                    <i class="bi bi-pencil"></i> Editează
                </a>

                <form method="post" action="/Categories/Delete/@Model.Id" class="d-inline">
                    <button type="submit" class="btn btn-danger" onclick="return confirm('ATENȚIE: Ștergi categoria și TOATE produsele ei? Acțiunea este ireversibilă!')">
                        <i class="bi bi-trash"></i> Șterge
                    </button>
                </form>
            }
        </div>
    </div>

    @* --- LISTAREA PRODUSELOR --- *@
    <div class="row">
        @{
            // LOGICA DE FILTRARE IN VIEW:
            // 1. Adminul vede tot.
            // 2. Produsele "Approved" sunt vazute de toata lumea.
            // 3. Userul curent (Colaborator) isi vede propriile produse "Pending".
            var productsToShow = (Model.Products ?? new List<Product>())
                    .Where(p => p.Status == "Approved" || User.IsInRole("Admin") || (currentUserId != null && p.UserId == currentUserId))
                    .OrderByDescending(p => p.Id)
                    .ToList();
        }

        @if (productsToShow.Any())
        {
            @foreach (var product in productsToShow)
            {
                <div class="col-md-3 mb-4">
                    <div class="card h-100 shadow-sm border-0">
                        @* Imaginea produsului *@
                        <div style="height: 200px; overflow: hidden;" class="bg-light d-flex align-items-center justify-content-center rounded-top">
                            <img src="@product.Image" class="card-img-top" alt="@product.Title" style="height: 100%; width: 100%; object-fit: cover;">
                        </div>

                        <div class="card-body d-flex flex-column">
                            @* Titlu si Pret *@
                            <h5 class="card-title text-truncate" title="@product.Title">@product.Title</h5>
                            <p class="card-text text-success fw-bold fs-5">@product.Price RON</p>

                            @* Eticheta Status (Doar daca e Pending) *@
                            @if (product.Status == "Pending")
                            {
                                <div class="mb-2">
                                    <span class="badge bg-warning text-dark border border-warning">
                                        <i class="bi bi-hourglass-split"></i> În așteptare
                                    </span>
                                </div>
                            }

                            @* Buton Detalii *@
                            <a href="/Products/Show/@product.Id" class="btn btn-primary mt-auto w-100 rounded-pill">
                                Vezi detalii
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-light text-center border p-5">
                    <i class="bi bi-box-seam fs-1 text-muted"></i>
                    <p class="mt-3 text-muted">Nu există produse vizibile în această categorie momentan.</p>
                    @if (User.IsInRole("Admin") || User.IsInRole("Proposer"))
                    {
                        <a href="/Products/New" class="btn btn-sm btn-outline-primary mt-2">Adaugă un produs nou</a>
                    }
                </div>
            </div>
        }
    </div>
</div>