@model OnlineShopProject_dNet.Models.Category

@{
    ViewBag.Title = "Lista categorii";
}

<div class="container mt-4">

    @* Mesaj de succes (TempData) *@
    @if (TempData["message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>@ViewBag.Title</h2>

        @* BUTON ADAUGARE - DOAR ADMIN *@
        @if (User.IsInRole("Admin"))
        {
            <a class="btn btn-success" href="/Categories/New">
                <i class="bi bi-plus-circle"></i> Adaugă Categorie
            </a>
        }
    </div>

    <a href="/Products/Index" class="btn btn-outline-secondary mb-4">&larr; Înapoi la produse</a>

    <div class="row">
        @foreach (var category in ViewBag.Categories)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body text-center d-flex flex-column justify-content-center">
                        <h4 class="card-title text-dark">@category.Name</h4>

                        <div class="mt-4 d-flex justify-content-center gap-2">
                            @* BUTON AFISARE - TOATA LUMEA *@
                            <a class="btn btn-primary btn-sm" href="/Categories/Show/@category.Id">Vezi Produse</a>

                            @* ZONA ADMIN: EDIT & DELETE *@
                            @if (User.IsInRole("Admin"))
                            {
                                <a class="btn btn-warning btn-sm" href="/Categories/Edit/@category.Id">Edit</a>

                                <form method="post" action="/Categories/Delete/@category.Id">
                                    <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('ATENȚIE: Ștergerea categoriei va șterge TOATE produsele din ea! Continui?')">Delete</button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>