@model OnlineShopProject_dNet.Models.Category

@{
    ViewBag.Title = "Adaugare Categorie";
}

<h2>Adaugare Categorie</h2>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form method="post" asp-controller="Categories" asp-action="New">

    <label asp-for="Name">Nume categorie</label>
    <br />

    <input type="text" asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>

    <br /><br />
    <button class="btn btn-success" type="submit">Adauga categorie</button>
</form>