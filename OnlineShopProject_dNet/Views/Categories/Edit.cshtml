@{
    ViewBag.Title = "Editare categorie";
}

<h2>@ViewBag.Title</h2>

<form method="post" action="/Categories/Edit/@ViewBag.Category.Id">


    <label>Nume categorie</label>
    <br /> <input type="text" name="Name" value="@ViewBag.Category.Name" />
    <br /><br />

    <button class="btn btn-success" type="submit">Modifica categoria</button>
</form>