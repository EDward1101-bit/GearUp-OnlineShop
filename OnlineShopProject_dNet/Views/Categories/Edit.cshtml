@model OnlineShopProject_dNet.Models.Category

@{
    ViewBag.Title = "Editare categorie";
}

<h2>@ViewBag.Title</h2>
<hr />

<form method="post" asp-controller="Categories" asp-action="Edit" asp-route-id="@Model.Id">

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label">Nume categorie</label>
        <input type="text" asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <button class="btn btn-success" type="submit">
        <i class="bi bi-pencil-square"></i> Modifică categoria
    </button>

    <a href="/Categories/Index" class="btn btn-outline-secondary">Anulează</a>

</form>