@model OnlineShopProject_dNet.Controllers.AdminUsersPageVm
@{
    ViewBag.Title = "Gestionare utilizatori";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-3">
        <div>
            <h2 class="mb-1">Gestionare Colaboratori</h2>
            <div class="text-muted small">Se afiseaza doar utilizatorii cu rol Proposer. Foloseste cautarea pentru a gasi orice utilizator si a-i acorda / revoca rolul.</div>
        </div>
        <form method="get" class="d-flex gap-2" role="search">
            <input type="text" name="search" class="form-control" placeholder="Cauta dupa email, user, nume" value="@Model.Search" />
            <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Caut?</button>
        </form>
    </div>

    @if (TempData["message"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            @TempData["message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Nume</th>
                            <th>Email</th>
                            <th>Admin</th>
                            <th>Proposer</th>
                            <th>Actiuni</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Items.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">Nu exista rezultate.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var u in Model.Items)
                            {
                                <tr>
                                    <td>@(string.IsNullOrWhiteSpace(u.Name) ? "-" : u.Name)</td>
                                    <td>@u.Email</td>
                                    <td>
                                        @if (u.IsAdmin)
                                        {
                                            <span class="badge bg-primary">Admin</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">User</span>
                                        }
                                    </td>
                                    <td>
                                        @if (u.IsProposer)
                                        {
                                            <span class="badge bg-success">Da</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Nu</span>
                                        }
                                    </td>
                                    <td>
                                        <form asp-action="ToggleProposer" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@u.Id" />
                                            <button type="submit" class="btn btn-sm @(u.IsProposer ? "btn-outline-danger" : "btn-outline-success")">
                                                @(u.IsProposer ? "Revoca" : "Acorda") rol Proposer
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Pagina utilizatori" class="mt-3">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Users", new { page = Model.Page - 1, search = Model.Search })">&laquo;</a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Users", new { page = i, search = Model.Search })">@i</a>
                    </li>
                }
                <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Users", new { page = Model.Page + 1, search = Model.Search })">&raquo;</a>
                </li>
            </ul>
        </nav>
    }
</div>
