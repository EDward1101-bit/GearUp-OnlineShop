@model OnlineShopProject_dNet.Models.Product
@using Microsoft.AspNetCore.Identity
@using OnlineShopProject_dNet.Models
@inject UserManager<ApplicationUser> UserManager

@{
    ViewBag.Title = "Lista Produse";

    // Transformăm ViewBag-ul într-o listă sigură
    var productsList = ViewBag.Products as IEnumerable<OnlineShopProject_dNet.Models.Product>;
}

@* Header Section - Modern Design *@
<div class="bg-gradient-primary text-white py-5 mb-4 rounded-3 shadow-lg" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="mb-2 fw-bold display-5">
                    <i class="bi bi-shop-window"></i> Magazin Online
                </h1>
                <p class="mb-0 fs-5 opacity-90">Descoperă produsele noastre premium</p>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                @if (User.IsInRole("Admin") || User.IsInRole("Proposer"))
                {
                    <a class="btn btn-light btn-lg shadow-sm" href="/Products/New">
                        <i class="bi bi-plus-circle"></i> Adaugă produs
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<div class="container">

    @* ZONA CĂUTARE, FILTRARE ȘI SORTARE *@
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form method="get" class="row g-3">
                        @* Căutare *@
                        <div class="col-md-4">
                            <label for="search" class="form-label fw-semibold">Caută produs</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-search"></i></span>
                                <input type="text" class="form-control" id="search" name="search"
                                       value="@ViewBag.Search" placeholder="Nume produs...">
                            </div>
                        </div>

                        @* Filtrare categorie *@
                        <div class="col-md-3">
                            <label for="category" class="form-label fw-semibold">Categorie</label>
                            <select class="form-select" id="category" name="category">
                                <option value="">Toate categoriile</option>
                                @foreach (var cat in ViewBag.Categories)
                                {
                                    if (cat.Id == ViewBag.SelectedCategory)
                                    {
                                        <option selected="selected" value="@cat.Id">@cat.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@cat.Id">@cat.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        @* Sortare *@
                        <div class="col-md-2">
                            <label for="sortBy" class="form-label fw-semibold">Sortează după</label>
                            <select class="form-select" id="sortBy" name="sortBy">
                                <option value="name" selected="@(ViewBag.SortBy == "name")">Nume</option>
                                <option value="price" selected="@(ViewBag.SortBy == "price")">Preț</option>
                                <option value="rating" selected="@(ViewBag.SortBy == "rating")">Rating</option>
                            </select>
                        </div>

                        @* Ordine sortare *@
                        <div class="col-md-2">
                            <label for="sortOrder" class="form-label fw-semibold">Ordine</label>
                            <select class="form-select" id="sortOrder" name="sortOrder">
                                <option value="asc" selected="@(ViewBag.SortOrder == "asc")">Crescător</option>
                                <option value="desc" selected="@(ViewBag.SortOrder == "desc")">Descrescător</option>
                            </select>
                        </div>

                        @* Buton căutare *@
                        <div class="col-md-1 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @* ZONA PRODUSE PENDING - DOAR ADMIN *@
    @if (User.IsInRole("Admin"))
    {
        var pendingProducts = ViewBag.PendingProducts as IEnumerable<OnlineShopProject_dNet.Models.Product>;
        if (pendingProducts != null && pendingProducts.Any())
        {
            <div id="pending-products" class="alert alert-warning border-0 shadow-lg mb-4 rounded-3" role="alert" style="background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%); border-left: 4px solid #f59e0b !important;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="mb-0 fw-bold text-dark">
                        <i class="bi bi-hourglass-split"></i> Produse în Așteptare
                        <span class="badge bg-danger ms-2">@pendingProducts.Count()</span>
                    </h4>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-3">
                    @foreach (var product in pendingProducts)
                    {
                        <div class="col">
                            <div class="card h-100 shadow-sm border-0" style="background: white;">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h6 class="card-title mb-0 fw-bold text-truncate" style="max-width: 70%;">@product.Title</h6>
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-hourglass-split"></i>
                                        </span>
                                    </div>
                                    <p class="text-muted small mb-1">
                                        <i class="bi bi-person-circle"></i> @(product.User?.UserName ?? "Necunoscut")
                                    </p>
                                    <p class="text-muted small mb-2">
                                        <i class="bi bi-tag"></i> @(product.Category?.Name ?? "Fără categorie")
                                    </p>
                                    <p class="text-danger fw-bold mb-3 fs-5">@product.Price <small class="fs-6">RON</small></p>
                                    <div class="d-grid gap-2">
                                        <form method="post" asp-controller="Products" asp-action="Approve" asp-route-id="@product.Id" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-success btn-sm w-100">
                                                <i class="bi bi-check-circle"></i> Aprobă
                                            </button>
                                        </form>
                                        <div class="btn-group" role="group">
                                            <form method="post" asp-controller="Products" asp-action="Reject" asp-route-id="@product.Id" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Sigur respingi acest produs?')">
                                                    <i class="bi bi-x-circle"></i>
                                                </button>
                                            </form>
                                            <a href="/Products/Show/@product.Id" class="btn btn-outline-primary btn-sm">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }

    @* ZONA PRODUSE PENDING PROPRIE - DOAR PROPOSER *@
    @if (User.IsInRole("Proposer"))
    {
        var myPendingProducts = ViewBag.MyPendingProducts as IEnumerable<OnlineShopProject_dNet.Models.Product>;
        if (myPendingProducts != null && myPendingProducts.Any())
        {
            <div class="card border-info mb-4 shadow-sm">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-hourglass-split"></i> Produsele Mele în Așteptare (@myPendingProducts.Count())
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
                        @foreach (var product in myPendingProducts)
                        {
                            <div class="col">
                                <div class="card h-100 border-info">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <h6 class="card-title mb-0">@product.Title</h6>
                                            <span class="badge bg-info">
                                                <i class="bi bi-hourglass-split"></i> În așteptare
                                            </span>
                                        </div>
                                        <p class="text-muted small mb-2">
                                            <i class="bi bi-tag"></i> @(product.Category?.Name ?? "Fără categorie")
                                        </p>
                                        <p class="text-danger fw-bold mb-3">@product.Price RON</p>
                                        <div class="d-flex gap-2">
                                            <a href="/Products/Show/@product.Id" class="btn btn-outline-primary btn-sm">
                                                <i class="bi bi-eye"></i> Vezi
                                            </a>
                                            <a href="/Products/Edit/@product.Id" class="btn btn-outline-warning btn-sm">
                                                <i class="bi bi-pencil"></i> Editează
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    }

    @* PRODUSE APROBATE - TOȚI *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0 fw-bold">
            <i class="bi bi-box-seam text-primary"></i> Produse Disponibile
        </h2>

        @if (productsList != null && productsList.Any())
        {
            <span class="badge bg-primary fs-6 px-3 py-2">
                @productsList.Count() produse
            </span>
        }
    </div>

    @if (productsList == null || !productsList.Any())
    {
        <div class="alert alert-warning text-center shadow-sm border-0" role="alert">
            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
            <h5>Nu există produse de afișat</h5>
            <p class="text-muted mb-0">Momentan nu sunt produse disponibile.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">
            @foreach (var product in productsList)
            {
                var currentUserId = UserManager.GetUserId(User);
                bool isInWishlist = currentUserId != null && (product.Wishlists?.Any(w => w.UserId == currentUserId) ?? false);
                string heartClass = isInWishlist ? "bi-heart-fill text-danger" : "bi-heart text-dark";

                <div class="col">
                    <div class="card h-100 shadow-sm border-0 product-card" style="transition: transform 0.2s, box-shadow 0.2s;">

                        @* ZONA IMAGINE *@
                        <div style="height: 280px; background-color: #f8f9fa; display: flex; align-items: center; justify-content: center; overflow: hidden; position: relative;">

                            @* 1. LINK PE IMAGINE *@
                            <a href="/Products/Show/@product.Id" class="w-100 h-100 d-flex align-items-center justify-content-center text-decoration-none">
                                @if (!string.IsNullOrEmpty(product.Image))
                                {
                                    <img src="@product.Image" class="card-img-top" alt="@product.Title" style="max-height: 100%; max-width: 100%; object-fit: contain; transition: transform 0.3s;" />
                                }
                                else
                                {
                                    <img src="/images/default-product.jpeg" class="card-img-top" alt="Fara imagine" style="max-height: 100%; max-width: 100%; object-fit: contain; transition: transform 0.3s;" />
                                }
                            </a>

                            @* 2. BADGE STOC *@
                            <div class="position-absolute top-0 start-0 m-2">
                                @if (product.Stock > 0)
                                {
                                    <span class="badge bg-success shadow-sm"><i class="bi bi-check-circle"></i> În Stoc</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger shadow-sm"><i class="bi bi-x-circle"></i> Stoc Epuizat</span>
                                }
                            </div>

                            @* 3. BUTOANE ACȚIUNE  *@
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <div class="position-absolute top-0 end-0 mt-4 me-3 d-flex flex-column gap-2" style="z-index: 10;">

                                    @* Buton Wishlist *@
                                    <button class="btn btn-light rounded-circle shadow-sm d-flex align-items-center justify-content-center"
                                            style="width: 38px; height: 38px;"
                                            onclick="toggleWishlist(@product.Id, this)"
                                            title="Favorite">
                                        <i class="bi @heartClass fs-5"></i>
                                    </button>

                                    @* Buton Coș (Doar dacă e stoc) *@
                                    @if (product.Stock > 0)
                                    {
                                        <button class="btn btn-primary rounded-circle shadow-sm d-flex align-items-center justify-content-center"
                                                style="width: 38px; height: 38px;"
                                                onclick="addToCart(@product.Id)"
                                                title="Adaugă în coș">
                                            <i class="bi bi-cart-plus fs-5"></i>
                                        </button>
                                    }
                                </div>
                            }
                        </div>

                        <div class="card-body d-flex flex-column">
                            @* Categorie *@
                            <div class="mb-2">
                                <small class="text-muted">
                                    <i class="bi bi-tag"></i> @(product.Category?.Name ?? "Fără Categorie")
                                </small>
                            </div>

                            @* Titlu *@
                            <h5 class="card-title text-truncate mb-2" style="min-height: 2.5rem;">
                                <a href="/Products/Show/@product.Id" class="text-dark text-decoration-none">
                                    @product.Title
                                </a>
                            </h5>

                            @* Rating dacă există *@
                            @if (product.Rating.HasValue)
                            {
                                <div class="mb-2 d-flex align-items-center gap-1">
                                    <div class="text-warning">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= Math.Round(product.Rating.Value))
                                            {
                                                <i class="bi bi-star-fill" style="font-size: 0.85rem;"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-star" style="font-size: 0.85rem;"></i>
                                            }
                                        }
                                    </div>
                                    <small class="text-muted">(@product.Rating.Value.ToString("0.0"))</small>
                                </div>
                            }

                            @* Descriere *@
                            <p class="card-text text-muted small mb-3" style="height: 60px; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical;">
                                @product.Description
                            </p>

                            @* Preț *@
                            <div class="mt-auto">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="fs-4 fw-bold text-danger mb-0">
                                        @product.Price <small class="fs-6 text-muted">RON</small>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <style>
            .product-card {
                border-radius: 12px;
                overflow: hidden;
                transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            }

                .product-card:hover {
                    transform: translateY(-8px) scale(1.02);
                    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04) !important;
                }

                    .product-card:hover img {
                        transform: scale(1.1);
                    }

                .product-card .card-body {
                    background: linear-gradient(to bottom, #ffffff 0%, #f8fafc 100%);
                }

            .bg-gradient-primary {
                background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            }
        </style>

        @if (ViewBag.TotalPages > 1)
        {
            var currentPage = (int)ViewBag.Page;
            var totalPages = (int)ViewBag.TotalPages;
            <nav aria-label="Paginare produse" class="mt-4">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = currentPage - 1, category = ViewBag.SelectedCategory, search = ViewBag.Search, sortBy = ViewBag.SortBy, sortOrder = ViewBag.SortOrder })">&laquo;</a>
                    </li>
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { page = i, category = ViewBag.SelectedCategory, search = ViewBag.Search, sortBy = ViewBag.SortBy, sortOrder = ViewBag.SortOrder })">@i</a>
                        </li>
                    }
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = currentPage + 1, category = ViewBag.SelectedCategory, search = ViewBag.Search, sortBy = ViewBag.SortBy, sortOrder = ViewBag.SortOrder })">&raquo;</a>
                    </li>
                </ul>
            </nav>
        }
    }

    @section Scripts {
        <script>
            // Funcție AJAX pentru Wishlist
            function toggleWishlist(productId, btn) {
                try {
                    const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                    const token = tokenInput ? tokenInput.value : '';
                    if (!token) {
                        console.error('Anti-forgery token not found');
                        alert('Eroare de securitate. Te rugăm să reîncarci pagina.');
                        return;
                    }
                    const bodyStr = `productId=${productId}&__RequestVerificationToken=${encodeURIComponent(token)}`;
                    fetch('/Wishlist/Toggle', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: bodyStr
                    })
                .then(res => {
                    if (!res.ok) {
                        throw new Error(`HTTP error! status: ${res.status}`);
                    }
                    return res.json();
                })
                .then(data => {
                    if (data.success) {
                        const icon = btn.querySelector('i');
                        if (icon) {
                            if (data.action === 'added') {
                                icon.className = 'bi bi-heart-fill fs-5 text-danger';
                            } else {
                                icon.className = 'bi bi-heart fs-5 text-dark';
                            }
                        }
                        // Update wishlist badge if available
                        if (data.wishlistCount !== undefined) {
                            const wb = document.getElementById('wishlist-badge-count');
                            if (wb) {
                                wb.textContent = data.wishlistCount;
                                wb.style.display = data.wishlistCount > 0 ? 'inline-block' : 'none';
                            }
                        }
                        if (typeof showToast === 'function') {
                            showToast(data.message || (data.action === 'added' ? 'Adăugat la favorite' : 'Eliminat din favorite'), 'success');
                        }
                        // Reîncărcare rapidă pentru a actualiza badge-ul din Navbar
                        if (typeof loadMiniCart === 'function') {
                            loadMiniCart();
                        }
                    } else {
                        if (typeof showToast === 'function') {
                            showToast(data.message || 'Eroare', 'danger');
                        } else {
                            alert(data.message || 'Eroare');
                        }
                    }
                })
                .catch(err => {
                    console.error('Wishlist toggle error:', err);
                    if (typeof showToast === 'function') {
                        showToast('Eroare rețea. Te rugăm să încerci din nou.', 'danger');
                    } else {
                        alert('Eroare rețea. Te rugăm să încerci din nou.');
                    }
                });
            } catch (e) {
                console.error('Wishlist toggle failed', e);
                alert('Eroare la actualizarea favorite.');
            }
            }

            // Funcție AJAX pentru Coș
            function addToCart(productId) {
                if (window.isAuthenticated) {
                    try {
                        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                        const token = tokenInput ? tokenInput.value : '';
                        if (!token) {
                            console.error('Anti-forgery token not found');
                            alert('Eroare de securitate. Te rugăm să reîncarci pagina.');
                            return;
                        }
                        const bodyStr = `productId=${productId}&quantity=1&__RequestVerificationToken=${encodeURIComponent(token)}`;
                        fetch('/Orders/AddToCart', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            body: bodyStr
                        })
                    .then(res => {
                        if (!res.ok) {
                            throw new Error(`HTTP error! status: ${res.status}`);
                        }
                        return res.json();
                    })
                    .then(data => {
                        if (data.success) {
                            // update server mini-cart
                            if (typeof loadMiniCart === 'function') {
                                loadMiniCart();
                            }
                            if (typeof showToast === 'function') {
                                showToast('Produs adăugat în coș', 'success');
                            } else {
                                alert('Produs adăugat în coș!');
                            }
                        } else {
                            if (typeof showToast === 'function') {
                                showToast(data.message || 'Eroare la adăugare', 'danger');
                            } else {
                                alert(data.message || 'Eroare la adăugare');
                            }
                        }
                    })
                    .catch(err => {
                        console.error('Cart add error:', err);
                        if (typeof showToast === 'function') {
                            showToast('Eroare rețea. Te rugăm să încerci din nou.', 'danger');
                        } else {
                            alert('Eroare rețea. Te rugăm să încerci din nou.');
                        }
                    });
                    } catch (e) { 
                        console.error('Auth cart add failed', e);
                        alert('Eroare la adăugarea produsului.');
                    }
                } else {
                    // fallback to localStorage
                    if (typeof addToLocalCart === 'function') {
                        addToLocalCart(productId, 1, null);
                    } else {
                        alert('Te rugăm să te autentifici pentru a adăuga produse în coș.');
                    }
                }
            }
        </script>
    }
</div>