@model OnlineShopProject_dNet.Models.Product
@using Microsoft.AspNetCore.Identity
@using OnlineShopProject_dNet.Models
@inject UserManager<ApplicationUser> UserManager
@inject OnlineShopProject_dNet.Services.TextProcessingService _textProcessor

@{
ViewData["Title"] = "Detalii Produs";

    var currentUserId = UserManager.GetUserId(User);
    bool isInWishlist = currentUserId != null && (Model.Wishlists?.Any(w => w.UserId == currentUserId) ?? false);
    string heartClass = isInWishlist ? "bi-heart-fill text-danger" : "bi-heart";
    var reviewsTotal = ViewBag.ReviewsTotal as int? ?? Model.Reviews?.Count() ?? 0;
}

@if (TempData["message"] != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        @TempData["message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model == null)
{
    <div class="alert alert-danger">Produsul nu a fost găsit.</div>
}
else
{
    <div class="container my-5">
        <div class="row justify-content-center">
            @* --- CARD UNIC PENTRU PRODUS (Imagine + Detalii + Acțiuni) --- *@
            <div class="col-lg-8">
                <div class="card shadow-lg border-0">
                    <div class="card-body p-0">
                        @* IMAGINE (Top) *@
                        <div class="d-flex justify-content-center bg-light product-image-container">
                            <div class="product-image-wrapper">
                                @if (!string.IsNullOrEmpty(Model.Image))
                                {
                                    <img src="@Model.Image" alt="@Model.Title" class="product-img" />
                                }
                                else
                                {
                                    <img src="/images/default-product.jpeg" alt="Imagine indisponibilă" class="product-img" />
                                }
                            </div>
                        </div>

                        @* DETALII PRODUS (Bottom) *@
                        <div class="p-4">
                            @* 1. Titlu *@
                            <h1 class="fw-bold text-dark mb-2">@Model.Title</h1>

                            @* 2. Rating + Review Count *@
                            @if (Model.Rating.HasValue)
                            {
                                <div class="d-flex align-items-center gap-2 mb-3">
                                    <div class="d-flex align-items-center gap-1 text-warning">
                                        <i class="bi bi-star-fill"></i>
                                        <strong>@Model.Rating.Value.ToString("0.0")</strong>
                                    </div>
                                    @if (reviewsTotal > 0)
                                    {
                                        <small class="text-muted">
                                            (@reviewsTotal @(reviewsTotal == 1 ? "review" : "review-uri"))
                                        </small>
                                    }
                                </div>
                            }

                            @* 3. Preț (prominent) *@
                            <h2 class="text-danger fw-bold mb-3">
                                @(Model.Price?.ToString("0.##") ?? "-") <small class="fs-6 text-muted">RON</small>
                            </h2>

                            @* 4. Categorie & Stoc (badges) *@
                            <div class="d-flex gap-2 mb-3 flex-wrap">
                                <span class="badge bg-info text-dark">
                                    <i class="bi bi-tag-fill"></i> @(Model.Category?.Name ?? "Fără Categorie")
                                </span>
                                @if (Model.Stock.GetValueOrDefault() > 0)
                                {
                                    var stockValue = Model.Stock.GetValueOrDefault();
                                    if (stockValue == 1)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-exclamation-circle"></i> Ultimul produs
                                        </span>
                                    }
                                    else if (stockValue <= 10)
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle"></i> În stoc (@stockValue bucăți)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle"></i> În stoc
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        <i class="bi bi-x-circle"></i> Stoc epuizat
                                    </span>
                                }
                            </div>

                            <hr class="my-3" />

                            @* 5. Descriere *@
                            <div class="card-text text-secondary lh-lg mb-4" style="white-space: normal;">
                                @Html.Raw(_textProcessor.ProcessForDisplay(Model.Description))
                            </div>

                            <hr class="my-3" />

                            @* 6. ACȚIUNI (Cantitate + Add to Cart + Wishlist) *@
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <div class="d-flex align-items-end gap-3 mb-4 flex-wrap">
                                    @{
                                        var availableStock = Model.Stock.GetValueOrDefault();
                                    }

                                    @if (availableStock > 0)
                                    {
                                        <div>
                                            <label class="form-label small fw-bold d-block mb-2">Cantitate</label>
                                            <input type="number" id="qtyInput" class="form-control" value="1" min="1" @(availableStock <= 10 ? $"max=\"{availableStock}\"" : "") style="width: 80px;">
                                        </div>
                                        <button class="btn btn-primary btn-lg fw-bold flex-grow-1" id="addToCartBtn" data-product-id="@Model.Id">
                                            <i class="bi bi-cart-plus me-2"></i> Adaugă în coș
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-secondary btn-lg flex-grow-1" disabled>
                                            <i class="bi bi-exclamation-circle me-2"></i> Stoc epuizat
                                        </button>
                                    }

                                    <button class="btn btn-outline-secondary btn-lg px-4 wishlist-btn" id="wishlistBtn" data-product-id="@Model.Id" title="Adaugă la favorite">
                                        <i class="bi @heartClass fs-5"></i>
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-light border border-warning text-center mb-4">
                                    <i class="bi bi-lock"></i>
                                    <a href="/Identity/Account/Login" class="fw-bold">Autentifică-te</a> pentru a cumpăra acest produs.
                                </div>
                            }

                            @* 7. ADMIN / PROPOSER ACTIONS *@
                            <div class="d-flex gap-2 flex-wrap pt-3 border-top">
                                @if (User.IsInRole("Admin"))
                                {
                                    <a href="/Products/Edit/@Model.Id" class="btn btn-warning btn-sm">
                                        <i class="bi bi-pencil me-1"></i> Editează
                                    </a>
                                    <form method="post" asp-controller="Products" asp-action="Delete" asp-route-id="@Model.Id" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Sigur ștergi produsul?');">
                                            <i class="bi bi-trash me-1"></i> Șterge
                                        </button>
                                    </form>
                                    @if (Model.Status == "Pending")
                                    {
                                        <button type="button" class="btn btn-success btn-sm" 
                                                onclick="openFeedbackModal(@Model.Id, '@Model.Title', 'approve')">
                                            <i class="bi bi-check-circle me-1"></i> Aprobă
                                        </button>
                                        <button type="button" class="btn btn-danger btn-sm" 
                                                onclick="openFeedbackModal(@Model.Id, '@Model.Title', 'reject')">
                                            <i class="bi bi-x-circle me-1"></i> Respinge
                                        </button>
                                    }
                                }
                                else if (User.IsInRole("Proposer") && Model.UserId != null && Model.UserId == UserManager.GetUserId(User) && string.Equals(Model.Status, "Rejected", StringComparison.OrdinalIgnoreCase))
                                {
                                    <a href="/Products/Edit/@Model.Id" class="btn btn-warning btn-sm">
                                        <i class="bi bi-pencil me-1"></i> Editează
                                    </a>
                                    <form method="post" action="/Products/Delete/@Model.Id" class="d-inline">
                                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Sigur ștergi produsul?');">
                                            <i class="bi bi-trash me-1"></i> Șterge
                                        </button>
                                    </form>
                                }

                                <a href="/Products/Index" class="btn btn-outline-secondary btn-sm ms-auto">
                                    <i class="bi bi-arrow-left me-1"></i> Înapoi
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* --- AI ASSISTANT & REVIEW-URI --- *@
        <div class="row justify-content-center mt-5">
            <div class="col-lg-4 mb-4">
                @* AI PRODUCT ASSISTANT *@
                <div class="card shadow-lg border-0 h-100">
                    <div class="card-header bg-gradient-primary text-white">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-robot"></i> Asistent Produs AI
                        </h5>
                    </div>
                    <div class="card-body d-flex flex-column">
                        <p class="text-muted small mb-3">
                            Întreabă-mă orice despre acest produs! Pot răspunde la întrebări despre specificații, utilizare, garanție și multe altele.
                        </p>

                        @* Zona conversație *@
                        <div id="ai-chat-messages" class="flex-grow-1 mb-3" style="max-height: 300px; overflow-y: auto;">
                            <div class="ai-message ai-welcome text-center text-muted py-3">
                                <i class="bi bi-chat-dots fs-1 mb-2"></i>
                                <p class="mb-0">Salut! Sunt asistentul tău pentru acest produs. Ce întrebare ai?</p>
                            </div>
                        </div>

                        @* Formular întrebare *@
                        <form id="ai-question-form" class="mt-auto">
                            @Html.AntiForgeryToken()
                            <div class="input-group">
                                <input type="text" id="ai-question-input" class="form-control"
                                       placeholder="Ex: Are garanție? Este potrivit pentru copii?" maxlength="500">
                                <button class="btn btn-primary" type="submit" id="ai-submit-btn">
                                    <i class="bi bi-send"></i>
                                </button>
                            </div>
                            <div class="form-text">
                                <small class="text-muted">Întrebarea va fi trimisă către asistentul AI</small>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                <partial name="_ProductReviews" model="Model" />
            </div>
        </div>
    </div>

    @* Modal pentru Feedback *@
    <div class="modal fade" id="feedbackModal" tabindex="-1" aria-labelledby="feedbackModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="feedbackModalLabel">Feedback pentru Produs</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="feedbackForm" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <p id="feedbackProductInfo" class="mb-3"></p>
                        <div class="mb-3">
                            <label for="feedbackMessage" class="form-label">
                                Mesaj de feedback (opțional)
                            </label>
                            <textarea class="form-control" id="feedbackMessage" name="feedbackMessage" 
                                      rows="4" maxlength="1000" 
                                      placeholder="Adaugă un mesaj pentru proposer despre decizia ta..."></textarea>
                            <div class="form-text">Acest mesaj va fi trimis către proposer împreună cu notificarea.</div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Anulează</button>
                        <button type="submit" class="btn btn-primary" id="feedbackSubmitBtn">Confirmă</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            function openFeedbackModal(productId, productTitle, action) {
                const modal = new bootstrap.Modal(document.getElementById('feedbackModal'));
                const productInfo = document.getElementById('feedbackProductInfo');
                const submitBtn = document.getElementById('feedbackSubmitBtn');
                const form = document.getElementById('feedbackForm');
                
                if (action === 'approve') {
                    productInfo.innerHTML = `<strong>Aprobare produs:</strong> ${productTitle}`;
                    submitBtn.textContent = 'Aprobă Produs';
                    submitBtn.className = 'btn btn-success';
                    form.action = '/Products/Approve/' + productId;
                } else {
                    productInfo.innerHTML = `<strong>Respingere produs:</strong> ${productTitle}`;
                    submitBtn.textContent = 'Respinge Produs';
                    submitBtn.className = 'btn btn-danger';
                    form.action = '/Products/Reject/' + productId;
                }
                
                document.getElementById('feedbackMessage').value = '';
                modal.show();
            }

            document.addEventListener('DOMContentLoaded', function() {
                const addBtn = document.getElementById('addToCartBtn');
                const wishlistBtn = document.getElementById('wishlistBtn');

                if (addBtn) {
                    addBtn.addEventListener('click', function(e) {
                        const qtyInput = document.getElementById('qtyInput');
                        const qty = qtyInput ? qtyInput.value : 1;
                        const productId = this.getAttribute('data-product-id');
                        window.addToCartDetailed(productId, qty, this);
                    });
                }

                if (wishlistBtn) {
                    wishlistBtn.addEventListener('click', function(e) {
                        const productId = this.getAttribute('data-product-id');
                        window.toggleWishlistDetailed(productId, this);
                    });
                }

                // AI Chat functionality
                const aiForm = document.getElementById('ai-question-form');
                const aiInput = document.getElementById('ai-question-input');
                const aiMessages = document.getElementById('ai-chat-messages');
                const aiSubmitBtn = document.getElementById('ai-submit-btn');
                const fallbackAnswer = 'Momentan nu avem detalii despre acest aspect.';
                const productId = '@Model.Id';

                aiForm.addEventListener('submit', async function(e) {
                    e.preventDefault();
                    const question = aiInput.value.trim();

                    if (!question) {
                        addMessageToChat('ai', fallbackAnswer);
                        return;
                    }

                    aiInput.disabled = true;
                    aiSubmitBtn.disabled = true;
                    aiSubmitBtn.innerHTML = '<i class="bi bi-hourglass-split"></i>';

                    addMessageToChat('user', question);
                    const loadingMessage = addLoadingMessage();

                    try {
                        const tokenInput = aiForm.querySelector('input[name="__RequestVerificationToken"]');
                        const token = tokenInput ? tokenInput.value : '';

                        const body = new URLSearchParams();
                        body.append('productId', productId);
                        body.append('question', question);
                        if (token) {
                            body.append('__RequestVerificationToken', token);
                        }

                        const response = await fetch('/Products/AskProductAssistant', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/x-www-form-urlencoded'
                            },
                            body: body.toString()
                        });

                        const data = await response.json().catch(() => null);
                        const answer = (data && typeof data.answer === 'string' && data.answer.trim().length > 0)
                            ? data.answer.trim()
                            : fallbackAnswer;

                        updateLoadingMessage(loadingMessage, answer);
                    } catch (error) {
                        console.error('AI Chat Error:', error);
                        updateLoadingMessage(loadingMessage, fallbackAnswer);
                    } finally {
                        aiInput.disabled = false;
                        aiSubmitBtn.disabled = false;
                        aiSubmitBtn.innerHTML = '<i class="bi bi-send"></i>';
                        aiInput.value = '';
                        aiInput.focus();
                    }
                });

                function addMessageToChat(sender, message) {
                    const messageDiv = document.createElement('div');
                    messageDiv.className = `ai-message ai-${sender} mb-3 p-2 rounded`;

                    if (sender === 'user') {
                        messageDiv.classList.add('bg-primary', 'text-white', 'ms-3');
                        messageDiv.innerHTML = `<strong>Tu:</strong> ${message}`;
                    } else {
                        messageDiv.classList.add('bg-light', 'border', 'me-3');
                        messageDiv.innerHTML = `<strong><i class="bi bi-robot"></i> Asistent:</strong> ${message}`;
                    }

                    removeWelcomeMessage();
                    aiMessages.appendChild(messageDiv);
                    aiMessages.scrollTop = aiMessages.scrollHeight;
                }

                function addLoadingMessage() {
                    const loadingDiv = document.createElement('div');
                    loadingDiv.className = 'ai-message ai-loading mb-3 p-2 rounded bg-light border me-3 d-flex align-items-center gap-2';
                    loadingDiv.innerHTML = `<span class="spinner-border spinner-border-sm text-secondary" role="status" aria-hidden="true"></span><span><strong><i class="bi bi-robot"></i> Asistent:</strong> AI scrie...</span>`;
                    removeWelcomeMessage();
                    aiMessages.appendChild(loadingDiv);
                    aiMessages.scrollTop = aiMessages.scrollHeight;
                    return loadingDiv;
                }

                function updateLoadingMessage(target, message) {
                    if (!target) {
                        addMessageToChat('ai', message);
                        return;
                    }

                    target.className = 'ai-message ai-ai mb-3 p-2 rounded bg-light border me-3';
                    target.innerHTML = `<strong><i class="bi bi-robot"></i> Asistent:</strong> ${message}`;
                    aiMessages.scrollTop = aiMessages.scrollHeight;
                }

                function removeWelcomeMessage() {
                    const welcomeMsg = aiMessages.querySelector('.ai-welcome');
                    if (welcomeMsg) {
                        welcomeMsg.remove();
                    }
                }
            });
        </script>
    }
}