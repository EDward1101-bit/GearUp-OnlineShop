@model OnlineShopProject_dNet.Models.Product

@{
    ViewBag.Title = "Detalii Produs";
}

@if (Model == null)
{
    @* Protectie in cazul extrem in care modelul e null *@
    <div class="alert alert-danger">Produsul nu a fost găsit sau a apărut o eroare la încărcare.</div>
}
else
{
    <div class="container my-5">
        <div class="card shadow-lg border-0">
            <div class="row g-0">

                @* IMAGINEA *@
                <div class="col-md-6 d-flex align-items-center justify-content-center bg-light" style="min-height: 400px;">
                    @if (!string.IsNullOrEmpty(Model.Image))
                    {
                        <img src="@Model.Image"
                             alt="@Model.Title"
                             class="img-fluid rounded-start"
                             style="max-height: 500px; width: auto; object-fit: contain;" />
                    }
                    else
                    {
                        @* Fallback *@
                        <img src="/images/default-product.jpeg"
                             alt="Imagine indisponibilă"
                             class="img-fluid rounded-start"
                             style="max-height: 500px; width: auto; object-fit: contain;" />
                    }
                </div>

                @* DETALIILE *@
                <div class="col-md-6">
                    <div class="card-body p-5 h-100 d-flex flex-column">

                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="badge bg-info text-dark fs-6">
                                @* Folosim ?. pentru a evita crash daca Category e null *@
                                <i class="bi bi-tag-fill"></i> @(Model.Category?.Name ?? "Fără Categorie")
                            </span>

                            @if (Model.Stock > 0)
                            {
                                <span class="badge bg-success fs-6">În Stoc</span>
                            }
                            else
                            {
                                <span class="badge bg-danger fs-6">Stoc Epuizat</span>
                            }
                        </div>

                        <h1 class="card-title fw-bold text-primary mb-3">@Model.Title</h1>
                        <h2 class="text-danger fw-bold mb-4">@Model.Price RON</h2>

                        <h5 class="text-muted mb-2">Descriere:</h5>
                        <p class="card-text fs-5 text-secondary flex-grow-1">
                            @Model.Description
                        </p>

                        <p class="text-muted"><small>Stoc disponibil: @Model.Stock bucăți</small></p>

                        <hr />

                        <div class="d-flex gap-2 flex-wrap mt-3">
                            <a href="/Products/Edit/@Model.Id" class="btn btn-warning px-4">
                                Editează
                            </a>

                            <form method="post" action="/Products/Delete/@Model.Id">
                                <button type="submit" class="btn btn-danger px-4" onclick="return confirm('Sigur stergi?');">
                                    Șterge
                                </button>
                            </form>

                            <a href="/Products/Index" class="btn btn-outline-secondary px-4 ms-auto">
                                Înapoi
                            </a>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
}