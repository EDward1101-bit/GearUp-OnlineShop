@model OnlineShopProject_dNet.Models.Product

@{
    ViewData["Title"] = "Adauga Produs";
}

<h2 class="text-center mb-4">Adaugare Produs</h2>
<hr />

@* Adaugam enctype pentru a permite trimiterea fisierelor  *@
<form asp-controller="Products" asp-action="New" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    
    @* Validation Summary *@
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label for="Title" class="form-label">Titlu Produs</label>
        <input type="text" name="Title" id="Title" class="form-control" value="@(Model?.Title)" />
        @Html.ValidationMessage("Title", new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        <label for="Description" class="form-label">Descriere Produs</label>
        <textarea name="Description" id="Description" class="form-control" rows="5">@(Model?.Description)</textarea>
        @Html.ValidationMessage("Description", new { @class = "text-danger" })
    </div>

    @* Campul pentru incarcarea imaginii*@
    <div class="mb-3">
        <label for="Image" class="form-label">Imagine Produs</label>
        <input type="file" name="Image" class="form-control" />
        @Html.ValidationMessage("Image", new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        <label for="Price" class="form-label">Pret (RON)</label>
        <input type="number" name="Price" id="Price" class="form-control" step="0.01" value="@(Model?.Price)" min="0.01" />
        @Html.ValidationMessage("Price", new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        <label for="Stock" class="form-label">Stoc (Bucati)</label>
        <input type="number" name="Stock" id="Stock" class="form-control" step="1" value="@(Model?.Stock)" min="0" />
        @Html.ValidationMessage("Stock", new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        <label for="CategoryId" class="form-label">Selectati Categoria</label>
        <select name="CategoryId" id="CategoryId" class="form-select">
            <option value="0">--- Selecteaza Categoria ---</option>
            @foreach (var item in ViewBag.Categories)
            {
                <option value="@item.Id" selected="@(Model?.CategoryId == item.Id ? "selected" : null)">
                    @item.Name
                </option>
            }
        </select>
        @Html.ValidationMessage("CategoryId", new { @class = "text-danger" })
    </div>

    <button class="btn btn-success mt-3" type="submit">Adauga Produsul</button>
</form>