@model OnlineShopProject_dNet.Models.Product
@using Microsoft.AspNetCore.Identity
@using OnlineShopProject_dNet.Models

@inject UserManager<ApplicationUser> UserManager

@* Includem CSS-ul pentru iconite direct aici *@
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    /* Stiluri simple pentru stele clickable */
    .star-rating i {
        cursor: pointer;
        transition: color 0.2s;
    }

    .star-rating i:hover {
        transform: scale(1.2);
    }
</style>

<div class="card shadow-sm border-0 mt-5 mb-5">
    <div class="card-header bg-white border-bottom-0 pt-4">
        <h3 class="mb-0 text-primary"><i class="bi bi-chat-left-text-fill"></i> Review-uri și Opinii</h3>
    </div>
    <div class="card-body">

        @* --- ZONA 1: LISTAREA REVIEW-URILOR --- *@
        @if (Model.Reviews != null && Model.Reviews.Any())
        {
            <div class="list-group list-group-flush">
                @foreach (var review in Model.Reviews.OrderByDescending(r => r.Date))
                {
                    <div class="list-group-item p-4 mb-3 border rounded shadow-sm bg-light" id="review-container-@review.Id">

                        @* --- MODUL VIZUALIZARE (DISPLAY) --- *@
                        <div id="view-mode-@review.Id">
                            <div class="d-flex w-100 justify-content-between align-items-start">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="bg-secondary text-white rounded-circle d-flex justify-content-center align-items-center" style="width: 40px; height: 40px;">
                                        <i class="bi bi-person-fill fs-5"></i>
                                    </div>
                                    <div>
                                        <h6 class="mb-0 fw-bold">@(review.User?.UserName ?? "Utilizator Anonim")</h6>
                                        <small class="text-muted">@review.Date.ToString("dd MMM yyyy, HH:mm")</small>
                                    </div>
                                </div>

                                @* Stele afisate static *@
                                <div class="text-warning fs-5">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (review.Rating.HasValue && i <= review.Rating.Value)
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                        else
                                        {

                                            <i class="bi bi-star"></i>
                                        }
                                    }
                                </div>
                            </div>

                            <p class="mb-3 mt-3 fs-6">@review.Content</p>

                            @* Butoane Edit/Delete *@
                            @if (User.Identity?.IsAuthenticated == true && (review.UserId == UserManager.GetUserId(User) || User.IsInRole("Admin")))
                            {
                                <div class="d-flex gap-2 justify-content-end border-top pt-2">
                                    @* Butonul care activeaza Editarea INLINE *@
                                    <button class="btn btn-sm btn-outline-primary" onclick="toggleEditMode(@review.Id)">
                                        <i class="bi bi-pencil"></i> Editează
                                    </button>

                                    <form method="post" action="/Reviews/Delete/@review.Id">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Ștergi review-ul?');">
                                            <i class="bi bi-trash"></i> Șterge
                                        </button>
                                    </form>
                                </div>
                            }
                        </div>

                        @* --- MODUL EDITARE (ASCUNS INITIAL) --- *@
                        @if (User.Identity?.IsAuthenticated == true && (review.UserId == UserManager.GetUserId(User) || User.IsInRole("Admin")))
                        {
                            <div id="edit-mode-@review.Id" style="display: none;">
                                <form method="post" action="/Reviews/Edit/@review.Id">

                                    <div class="mb-2">
                                        <label class="fw-bold">Modifică nota:</label>
                                        @* Sistem de stele interactiv pentru Editare *@
                                        <div class="star-rating d-inline-flex ms-2 fs-4 text-warning" data-review-id="@review.Id">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                /* Afisam stelele pline/goale in functie de nota existenta */
                                                var iconClass = (review.Rating.HasValue && i <= review.Rating.Value) ? "bi-star-fill" : "bi-star";
                                                <i class="bi @iconClass" data-value="@i" onclick="setRating(this, @review.Id)"></i>
                                            }
                                        </div>
                                        <input type="hidden" name="Rating" id="rating-input-@review.Id" value="@(review.Rating ?? 5)" />
                                    </div>

                                    <div class="mb-2">
                                        <label class="fw-bold">Modifică textul:</label>
                                        <textarea class="form-control" name="Content" rows="3">@review.Content</textarea>
                                    </div>

                                    <div class="d-flex justify-content-end gap-2">
                                        <button type="button" class="btn btn-secondary btn-sm" onclick="toggleEditMode(@review.Id)">Anulează</button>
                                        <button type="submit" class="btn btn-success btn-sm">Salvează Modificările</button>
                                    </div>
                                </form>
                            </div>
                        }

                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-secondary text-center">Nu există review-uri. Fii primul!</div>
        }

        <hr class="my-5" />

        @* --- ZONA 2: FORMULAR ADAUGARE REVIEW NOU --- *@
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="bg-light p-4 rounded-3 border">
                <h5>Lasă un review nou</h5>
                <form method="post" action="/Reviews/New">
                    <input type="hidden" name="ProductId" value="@Model.Id" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Nota ta:</label>
                        <div class="star-rating d-flex gap-1 fs-3 text-warning">
                            @* ID 0 pentru formularul de "Nou" *@
                            <i class="bi bi-star-fill" data-value="1" onclick="setRating(this, 0)"></i>
                            <i class="bi bi-star-fill" data-value="2" onclick="setRating(this, 0)"></i>
                            <i class="bi bi-star-fill" data-value="3" onclick="setRating(this, 0)"></i>
                            <i class="bi bi-star-fill" data-value="4" onclick="setRating(this, 0)"></i>
                            <i class="bi bi-star-fill" data-value="5" onclick="setRating(this, 0)"></i>
                        </div>
                        <input type="hidden" name="Rating" id="rating-input-0" value="5" />
                    </div>

                    <div class="mb-3">
                        <textarea class="form-control" name="Content" rows="3" placeholder="Opinia ta..." required></textarea>
                    </div>

                    <button type="submit" class="btn btn-success"><i class="bi bi-send-fill"></i> Postează</button>
                </form>
            </div>
        }
    </div>
</div>

@* --- SCRIPTURI JAVASCRIPT PENTRU FUNCTIONALITATE --- *@
<script>
    // 1. Functia care comuta intre Vizualizare si Editare
    function toggleEditMode(reviewId) {
        var viewDiv = document.getElementById('view-mode-' + reviewId);
        var editDiv = document.getElementById('edit-mode-' + reviewId);

        if (viewDiv.style.display === 'none') {
            viewDiv.style.display = 'block';
            editDiv.style.display = 'none';
        } else {
            viewDiv.style.display = 'none';
            editDiv.style.display = 'block';
        }
    }

    // 2. Functia care coloreaza stelele cand dai click
    // element = steaua pe care ai dat click
    // reviewId = ID-ul review-ului (0 pentru review nou)
    function setRating(element, reviewId) {
        var value = element.getAttribute('data-value');

        // Setam valoarea in input-ul ascuns specific acestui formular
        document.getElementById('rating-input-' + reviewId).value = value;

        // Gasim parintele stelelor (containerul)
        var parentContainer = element.parentElement;
        var stars = parentContainer.getElementsByTagName('i');

        // Coloram stelele
        for (var i = 0; i < stars.length; i++) {
            var starVal = stars[i].getAttribute('data-value');
            if (starVal <= value) {
                stars[i].classList.remove('bi-star');
                stars[i].classList.add('bi-star-fill');
            } else {
                stars[i].classList.remove('bi-star-fill');
                stars[i].classList.add('bi-star');
            }
        }
    }
</script>