@model OnlineShopProject_dNet.Models.Product
@using Microsoft.AspNetCore.Identity
@using OnlineShopProject_dNet.Models

@inject UserManager<ApplicationUser> UserManager

@* Link CSS pentru iconițe *@
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    /* Stiluri custom pentru noul design */
    .star-rating i {
        cursor: pointer;
        transition: color 0.2s;
    }

        .star-rating i:hover {
            transform: scale(1.1);
        }

    .user-avatar {
        width: 45px;
        height: 45px;
        font-size: 1.2rem;
        background-color: #e9ecef;
        color: #6c757d;
    }

    .review-stars-display {
        font-size: 0.9rem;
        color: #ffa41c; /* Amazon Orange */
    }
</style>

<div class="mt-5 mb-5">
    <h3 class="mb-4 text-dark fw-bold">Review-uri clienți</h3>

    <div class="row">
        <div class="col-12">

            @* --- ZONA 1: LISTAREA REVIEW-URILOR --- *@
            @if (Model.Reviews != null && Model.Reviews.Any())
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var review in Model.Reviews.OrderByDescending(r => r.Date))
                    {
                        string displayName = !string.IsNullOrEmpty(review.User?.FirstName)
                        ? review.User.FirstName
                        : (review.User?.UserName ?? "Anonim");

                        <div class="border-bottom pb-3" id="review-container-@review.Id">

                            @* --- MOD VIZUALIZARE --- *@
                            <div id="view-mode-@review.Id">

                                @* HEADER: Avatar + Nume *@
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <div class="user-avatar rounded-circle d-flex justify-content-center align-items-center">
                                        <i class="bi bi-person-fill"></i>
                                    </div>
                                    <span class="fw-bold text-dark">@displayName</span>
                                </div>

                                @* STELE + DATA *@
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <div class="review-stars-display d-flex">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (review.Rating.HasValue && i <= review.Rating.Value)
                                            {
                                                <i class="bi bi-star-fill"></i>
                                            }
                                            else
                                            {

                                                <i class="bi bi-star"></i>
                                            }
                                        }
                                    </div>
                                    <span class="text-secondary" style="font-size: 0.85rem;">@review.Date.ToString("dd MMMM yyyy")</span>
                                </div>

                                @* CONTINUT *@
                                <div class="text-break mb-2">
                                    @review.Content
                                </div>

                                @* BUTOANE ACTIUNE (Corectate pentru aliniere) *@
                                @if (User.Identity?.IsAuthenticated == true && (review.UserId == UserManager.GetUserId(User) || User.IsInRole("Admin")))
                                {
                                    <div class="d-flex align-items-center gap-3">
                                        @* Link Editeaza *@
                                        <a href="javascript:void(0)" onclick="toggleEditMode(@review.Id)" class="text-decoration-none text-muted small d-flex align-items-center gap-1">
                                            <i class="bi bi-pencil"></i> Editează
                                        </a>

                                        @* Buton Sterge *@
                                        <form method="post" action="/Reviews/Delete/@review.Id" class="d-inline-block m-0 p-0">
                                            <button type="submit" class="btn btn-link p-0 text-decoration-none text-danger small d-flex align-items-center gap-1" style="border: none; vertical-align: baseline;" onclick="return confirm('Ștergi review-ul?');">
                                                <i class="bi bi-trash"></i> Șterge
                                            </button>
                                        </form>
                                    </div>
                                }
                            </div>

                            @* --- MOD EDITARE (Inline) --- *@
                            @if (User.Identity?.IsAuthenticated == true && (review.UserId == UserManager.GetUserId(User) || User.IsInRole("Admin")))
                            {
                                <div id="edit-mode-@review.Id" style="display: none;" class="bg-light p-3 rounded mt-2">
                                    <form method="post" action="/Reviews/Edit/@review.Id">
                                        <div class="mb-2">
                                            <label class="small text-muted mb-1">Nota:</label>
                                            <div class="star-rating text-warning fs-5" data-review-id="@review.Id">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    var iconClass = (review.Rating.HasValue && i <= review.Rating.Value) ? "bi-star-fill" : "bi-star";
                                                    <i class="bi @iconClass" data-value="@i" onclick="setRating(this, @review.Id)"></i>
                                                }
                                            </div>
                                            <input type="hidden" name="Rating" id="rating-input-@review.Id" value="@(review.Rating ?? 5)" />
                                        </div>

                                        <div class="mb-2">
                                            <textarea class="form-control form-control-sm" name="Content" rows="3">@review.Content</textarea>
                                        </div>

                                        <div class="d-flex gap-2">
                                            <button type="submit" class="btn btn-sm btn-dark rounded-pill px-3">Salvează</button>
                                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" onclick="toggleEditMode(@review.Id)">Anulează</button>
                                        </div>
                                    </form>
                                </div>
                            }

                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-muted fst-italic">Nu există încă review-uri. Fii primul care scrie unul!</div>
            }

            <hr class="my-5" />

            @* --- ZONA 2: FORMULAR ADAUGARE --- *@
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="card border-light bg-light">
                    <div class="card-body">
                        <h5 class="card-title">Scrie un review</h5>
                        <form method="post" action="/Reviews/New">
                            <input type="hidden" name="ProductId" value="@Model.Id" />

                            <div class="mb-3">
                                <div class="star-rating d-flex gap-1 fs-4 text-warning">
                                    <i class="bi bi-star-fill" data-value="1" onclick="setRating(this, 0)"></i>
                                    <i class="bi bi-star-fill" data-value="2" onclick="setRating(this, 0)"></i>
                                    <i class="bi bi-star-fill" data-value="3" onclick="setRating(this, 0)"></i>
                                    <i class="bi bi-star-fill" data-value="4" onclick="setRating(this, 0)"></i>
                                    <i class="bi bi-star-fill" data-value="5" onclick="setRating(this, 0)"></i>
                                </div>
                                <input type="hidden" name="Rating" id="rating-input-0" value="5" />
                            </div>

                            <div class="mb-3">
                                <textarea class="form-control" name="Content" rows="3" placeholder="Detaliază experiența ta..." required></textarea>
                            </div>

                            <button type="submit" class="btn btn-warning rounded-pill px-4 fw-bold">Postează review</button>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-light border">
                    <a href="/Identity/Account/Login" class="fw-bold text-decoration-none">Autentifică-te</a> pentru a scrie un review.
                </div>
            }
        </div>
    </div>
</div>

<script>
    function toggleEditMode(reviewId) {
        var viewDiv = document.getElementById('view-mode-' + reviewId);
        var editDiv = document.getElementById('edit-mode-' + reviewId);

        if (viewDiv.style.display === 'none') {
            viewDiv.style.display = 'block';
            editDiv.style.display = 'none';
        } else {
            viewDiv.style.display = 'none';
            editDiv.style.display = 'block';
        }
    }

    function setRating(element, reviewId) {
        var value = element.getAttribute('data-value');
        document.getElementById('rating-input-' + reviewId).value = value;
        var parentContainer = element.parentElement;
        var stars = parentContainer.getElementsByTagName('i');
        for (var i = 0; i < stars.length; i++) {
            var starVal = stars[i].getAttribute('data-value');
            if (starVal <= value) {
                stars[i].classList.remove('bi-star');
                stars[i].classList.add('bi-star-fill');
            } else {
                stars[i].classList.remove('bi-star-fill');
                stars[i].classList.add('bi-star');
            }
        }
    }
</script>