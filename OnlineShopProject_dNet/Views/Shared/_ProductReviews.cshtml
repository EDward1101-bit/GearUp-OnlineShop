@model OnlineShopProject_dNet.Models.Product
@using Microsoft.AspNetCore.Identity
@using OnlineShopProject_dNet.Models

@inject UserManager<ApplicationUser> UserManager

@{
    var currentUserId = User.Identity?.IsAuthenticated == true ? UserManager.GetUserId(User) : null;
    var userHasReview = currentUserId != null && Model.Reviews != null && Model.Reviews.Any(r => r.UserId == currentUserId);
}

@* Link CSS pentru iconițe *@
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    /* Stiluri custom pentru noul design */
    .star-rating i {
        cursor: pointer;
        transition: color 0.2s;
    }

        .star-rating i:hover {
            transform: scale(1.1);
        }

    .user-avatar {
        width: 45px;
        height: 45px;
        font-size: 1.2rem;
        background-color: #e9ecef;
        color: #6c757d;
    }

    .review-stars-display {
        font-size: 0.9rem;
        color: #ffa41c; /* Amazon Orange */
    }
</style>

<div class="mt-5 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0 text-dark fw-bold">
            <i class="bi bi-star-fill text-warning"></i> Review-uri clienți
            @if (Model.Reviews != null && Model.Reviews.Any())
            {
                <span class="badge bg-secondary ms-2">@Model.Reviews.Count()</span>
            }
        </h3>
    </div>

    <div class="row">
        <div class="col-12">

            @* --- ZONA 1: LISTAREA REVIEW-URILOR --- *@
            @if (Model.Reviews != null && Model.Reviews.Any())
            {
                <div class="d-flex flex-column gap-4">
                    @foreach (var review in Model.Reviews.OrderByDescending(r => r.Date))
                    {
                        string displayName = review.User != null
                        ? (!string.IsNullOrEmpty(review.User.FirstName) && !string.IsNullOrEmpty(review.User.LastName)
                            ? $"{review.User.FirstName} {review.User.LastName}"
                            : review.User.UserName ?? "Anonim")
                        : "Anonim";

                        <div class="card border-0 shadow-sm" id="review-container-@review.Id">
                            <div class="card-body">

                            @* --- MOD VIZUALIZARE --- *@
                            <div id="view-mode-@review.Id">
                                @* HEADER: Avatar + Nume + Data + Ora *@
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="user-avatar rounded-circle d-flex justify-content-center align-items-center shadow-sm">
                                            <i class="bi bi-person-fill"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@displayName</div>
                                            <small class="text-muted">
                                                <i class="bi bi-calendar-event"></i>
                                                <span data-review-date="@review.Date.ToString("o")">@review.Date.ToString("dd MMMM yyyy, HH:mm")</span>
                                            </small>
                                        </div>
                                    </div>
                                </div>

                                @* STELE *@
                                <div class="mb-3">
                                    <div class="review-stars-display d-flex gap-1">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (review.Rating.HasValue && i <= review.Rating.Value)
                                            {
                                                <i class="bi bi-star-fill"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-star"></i>
                                            }
                                        }
                                    </div>
                                </div>

                                @* CONTINUT *@
                                <div class="text-break mb-3">
                                    <p class="mb-0">@review.Content</p>
                                </div>

                                @* BUTOANE ACTIUNE *@
                                @if (User.Identity?.IsAuthenticated == true && (review.UserId == UserManager.GetUserId(User) || User.IsInRole("Admin")))
                                {
                                    <div class="d-flex align-items-center gap-3 pt-2 border-top">
                                        <a href="javascript:void(0)" onclick="toggleEditMode(@review.Id)" class="text-decoration-none text-primary small d-flex align-items-center gap-1">
                                            <i class="bi bi-pencil"></i> Editează
                                        </a>
                                        <form method="post" action="/Reviews/Delete/@review.Id" class="d-inline-block m-0 p-0">
                                            <button type="submit" class="btn btn-link p-0 text-decoration-none text-danger small d-flex align-items-center gap-1" style="border: none; vertical-align: baseline;" onclick="return confirm('Ștergi review-ul?');">
                                                <i class="bi bi-trash"></i> Șterge
                                            </button>
                                        </form>
                                    </div>
                                }
                            </div>

                            @* --- MOD EDITARE (Inline) --- *@
                            @if (User.Identity?.IsAuthenticated == true && (review.UserId == UserManager.GetUserId(User) || User.IsInRole("Admin")))
                            {
                                <div id="edit-mode-@review.Id" style="display: none;" class="bg-light p-3 rounded mt-3 border">
                                    <form method="post" action="/Reviews/Edit/@review.Id">
                                        <div class="mb-3">
                                            <label class="form-label fw-semibold mb-2">Rating:</label>
                                            <div class="star-rating text-warning fs-5 d-flex gap-1" data-review-id="@review.Id">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    var iconClass = (review.Rating.HasValue && i <= review.Rating.Value) ? "bi-star-fill" : "bi-star";
                                                    <i class="bi @iconClass" data-value="@i" onclick="setRating(this, @review.Id)"></i>
                                                }
                                            </div>
                                            <input type="hidden" name="Rating" id="rating-input-@review.Id" value="@(review.Rating ?? 5)" />
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label fw-semibold mb-2">Comentariu:</label>
                                            <textarea class="form-control" name="Content" rows="4">@review.Content</textarea>
                                        </div>

                                        <div class="d-flex gap-2">
                                            <button type="submit" class="btn btn-primary px-3">
                                                <i class="bi bi-check"></i> Salvează
                                            </button>
                                            <button type="button" class="btn btn-outline-secondary px-3" onclick="toggleEditMode(@review.Id)">
                                                <i class="bi bi-x"></i> Anulează
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-light border-0 shadow-sm text-center py-4">
                    <i class="bi bi-chat-left-text fs-1 text-muted d-block mb-2"></i>
                    <p class="text-muted mb-0">Nu există încă review-uri. Fii primul care scrie unul!</p>
                </div>
            }

            <hr class="my-5" />

            @* --- ZONA 2: FORMULAR ADAUGARE --- *@
            @if (User.Identity?.IsAuthenticated == true)
            {
                @if (!userHasReview)
                {
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white border-bottom">
                            <h5 class="card-title mb-0">
                                <i class="bi bi-pencil-square text-primary"></i> Scrie un review
                            </h5>
                        </div>
                        <div class="card-body">
                            <form method="post" action="/Reviews/New">
                                <input type="hidden" name="ProductId" value="@Model.Id" />

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Rating:</label>
                                    <div class="star-rating d-flex gap-1 fs-4 text-warning">
                                        <i class="bi bi-star-fill" data-value="1" onclick="setRating(this, 0)"></i>
                                        <i class="bi bi-star-fill" data-value="2" onclick="setRating(this, 0)"></i>
                                        <i class="bi bi-star-fill" data-value="3" onclick="setRating(this, 0)"></i>
                                        <i class="bi bi-star-fill" data-value="4" onclick="setRating(this, 0)"></i>
                                        <i class="bi bi-star-fill" data-value="5" onclick="setRating(this, 0)"></i>
                                    </div>
                                    <input type="hidden" name="Rating" id="rating-input-0" value="5" />
                                    <small class="text-muted">Click pe stele pentru a selecta rating-ul</small>
                                </div>

                                <div class="mb-3">
                                    <label for="review-content" class="form-label fw-semibold">Comentariul tău:</label>
                                    <textarea class="form-control" id="review-content" name="Content" rows="4" placeholder="Detaliază experiența ta cu acest produs..." required></textarea>
                                </div>

                                <button type="submit" class="btn btn-primary px-4 fw-semibold">
                                    <i class="bi bi-send"></i> Postează review
                                </button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-info border-0 shadow-sm">
                        <i class="bi bi-info-circle"></i> <strong>Aveți deja un review pentru acest produs.</strong> Puteți edita review-ul existent din lista de mai sus.
                    </div>
                }
            }
            else
            {
                <div class="alert alert-light border shadow-sm">
                    <i class="bi bi-lock"></i> <a href="/Identity/Account/Login" class="fw-bold text-decoration-none">Autentifică-te</a> pentru a scrie un review.
                </div>
            }
        </div>
    </div>
</div>

<script>
    // Format relative time (3 hours ago, yesterday, etc)
    function formatRelativeTime(dateStr) {
        return window.formatRelativeTime(dateStr);
    }

    // Update all review timestamps on page load
    document.addEventListener('DOMContentLoaded', function() {
        window.updateRelativeTimestamps();
    });

    function toggleEditMode(reviewId) {
        var viewDiv = document.getElementById('view-mode-' + reviewId);
        var editDiv = document.getElementById('edit-mode-' + reviewId);

        if (viewDiv.style.display === 'none') {
            viewDiv.style.display = 'block';
            editDiv.style.display = 'none';
        } else {
            viewDiv.style.display = 'none';
            editDiv.style.display = 'block';
        }
    }

    function setRating(element, reviewId) {
        var value = element.getAttribute('data-value');
        document.getElementById('rating-input-' + reviewId).value = value;
        var parentContainer = element.parentElement;
        var stars = parentContainer.getElementsByTagName('i');
        for (var i = 0; i < stars.length; i++) {
            var starVal = stars[i].getAttribute('data-value');
            if (starVal <= value) {
                stars[i].classList.remove('bi-star');
                stars[i].classList.add('bi-star-fill');
            } else {
                stars[i].classList.remove('bi-star-fill');
                stars[i].classList.add('bi-star');
            }
        }
    }
</script>