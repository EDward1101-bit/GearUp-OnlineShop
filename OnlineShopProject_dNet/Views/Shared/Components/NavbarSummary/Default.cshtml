@model OnlineShopProject_dNet.Components.NavbarSummaryViewModel

@* 1. WISHLIST - Root este LI (Corect!) *@
<li class="nav-item me-3">
    <a class="nav-link position-relative" asp-controller="Wishlist" asp-action="Index" aria-label="Wishlist">
        <i class="bi bi-heart fs-5"></i>
        <span id="wishlist-badge-count" class="icon-badge badge rounded-pill bg-danger text-white" style="display:@(Model.WishlistCount>0?"inline-block":"none")">@Model.WishlistCount</span>
    </a>
</li>

@* 2. COȘ - Root este LI (Corect!), dar meniul din interior este DIV *@
<li class="nav-item dropdown">
    <a class="nav-link position-relative" href="#" id="cartDropdown" role="button"
       data-bs-toggle="dropdown" aria-expanded="false" onclick="loadMiniCart()">

        <i class="bi bi-cart3 fs-5"></i>
        <span id="cart-badge-count" class="icon-badge badge rounded-pill bg-warning text-dark" style="display:@(Model.CartCount>0?"inline-block":"none")">@Model.CartCount</span>
    </a>

    @* Folosim DIV pentru containerul dropdown, NU UL *@
    <div class="dropdown-menu dropdown-menu-end p-3 shadow-lg" aria-labelledby="cartDropdown" style="min-width: 320px;">

        <div class="dropdown-header text-uppercase text-muted fw-bold">Coșul meu</div>
        <div class="dropdown-divider"></div>

        @* Aici vine AJAX-ul care va returna DIV-uri. DIV în DIV e valid. *@
        <div id="miniCartContainer">
            <div class="text-center py-3 text-muted">
                <i class="bi bi-hourglass-split"></i> Se încarcă...
            </div>
        </div>

        <div class="dropdown-divider"></div>
    </div>
</li>