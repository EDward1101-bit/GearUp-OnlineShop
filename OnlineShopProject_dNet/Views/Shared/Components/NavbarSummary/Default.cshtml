@model OnlineShopProject_dNet.Components.NavbarSummaryViewModel

@* --- Tweakable badge CSS: edit the variables below to move/resize the little circle --- *@
<style>
    :root {
        --badge-top: 0.15rem;
        --badge-right: 0.15rem;
        --badge-size: 1.05rem;
        --badge-font-size: 0.75rem;
        --badge-border-color: #fff;
    }

    .badge-floating {
        position: absolute;
        top: var(--badge-top);
        right: var(--badge-right);
        transform: translate(50%, -50%);
        width: var(--badge-size);
        height: var(--badge-size);
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: var(--badge-font-size);
        line-height: 1;
        border-radius: 999px;
        border: 2px solid var(--badge-border-color);
        box-shadow: 0 0 0 1px rgba(0,0,0,0.06);
        z-index: 20;
        pointer-events: none;
    }

    .icon-wrapper {
        display: inline-block;
        position: relative;
        line-height: 1;
    }
</style>

@* 1. WISHLIST - Root este LI (Corect!) *@
<li class="nav-item me-3">
    <a class="nav-link" asp-controller="Wishlist" asp-action="Index" aria-label="Wishlist">
        <span class="icon-wrapper">
            <i class="bi bi-heart fs-5"></i>
            <span id="wishlist-badge-count"
                  class="icon-badge badge rounded-pill bg-danger text-white badge-floating"
                  style="@(Model.WishlistCount > 0 ? "display:inline-flex;" : "display:none;")">
                @Model.WishlistCount
            </span>
        </span>
    </a>
</li>

@* 2. COȘ *@
<li class="nav-item dropdown">
    <a class="nav-link" href="#" id="cartDropdown" role="button"
       data-bs-toggle="dropdown" aria-expanded="false" onclick="loadMiniCart()">

        <span class="icon-wrapper">
            <i class="bi bi-cart3 fs-5"></i>
            <span id="cart-badge-count"
                  class="icon-badge badge rounded-pill bg-warning text-dark badge-floating"
                  style="@(Model.CartCount > 0 ? "display:inline-flex;" : "display:none;")">
                @Model.CartCount
            </span>
        </span>
    </a>

    <div class="dropdown-menu dropdown-menu-end p-3 shadow-lg" aria-labelledby="cartDropdown" style="min-width: 320px;">
        <div class="dropdown-header text-uppercase text-muted fw-bold">Coșul meu</div>
        <div class="dropdown-divider"></div>

        <div id="miniCartContainer">
            <div class="text-center py-3 text-muted">
                <i class="bi bi-hourglass-split"></i> Se încarcă...
            </div>
        </div>

        <div class="dropdown-divider"></div>
    </div>
</li>