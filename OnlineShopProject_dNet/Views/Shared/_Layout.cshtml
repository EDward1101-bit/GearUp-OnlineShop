@using OnlineShopProject_dNet.Models
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@inject OnlineShopProject_dNet.Services.NotificationService NotificationService

@{
    // Obține numele complet al utilizatorului
    var currentUser = await UserManager.GetUserAsync(User);
    var unreadNotifications = currentUser != null ? await NotificationService.UnreadCountAsync(currentUser.Id) : 0;
    var displayName = currentUser != null
        ? (!string.IsNullOrEmpty(currentUser.FirstName) && !string.IsNullOrEmpty(currentUser.LastName)
            ? $"{currentUser.FirstName} {currentUser.LastName}"
            : currentUser.UserName ?? User.Identity?.Name ?? "Utilizator")
        : User.Identity?.Name ?? "Utilizator";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OnlineShopProject_dNet</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OnlineShopProject_dNet.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    @* Global anti-forgery token available for JavaScript (read-only) *@
    <div style="display:none">@Html.AntiForgeryToken()</div>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark shadow-lg sticky-top" style="z-index: 1030;">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-shop-window"></i> Magazin Online
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">

                    @* --- GRUP 1: MENIUL STÂNGA (Navigare) --- *@
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door"></i> Acasă
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Products" asp-action="Index">
                                <i class="bi bi-box-seam"></i> Produse
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="categoriesDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-grid-3x3-gap"></i> Categorii
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="categoriesDropdown" id="categoriesDropdownMenu">
                                <li><a class="dropdown-item" href="/Products/Index"><i class="bi bi-list-ul"></i> Toate produsele</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li class="px-3 py-2 text-muted small"><i class="bi bi-hourglass-split"></i> Se încarcă...</li>
                            </ul>
                        </li>


        <!-- mini cart placeholder; real loader defined later -->
                    </ul>

                    @* --- GRUP 2: MENIUL DREAPTA (Iconițe + User) --- *@
                    <div class="d-flex align-items-center">

                        @* 1. COȘ & WISHLIST (Iconițe cu badge-uri) *@
                        <ul class="navbar-nav align-items-center me-2">
                            @await Component.InvokeAsync("NavbarSummary")
                        </ul>

                        @* 2. USER MENU - Pentru toți utilizatorii autentificați *@
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <ul class="navbar-nav align-items-center">
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userMenuDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-person-circle fs-5 me-2"></i>
                                        <span class="d-none d-lg-inline">@displayName</span>
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userMenuDropdown" style="min-width: 250px;">
                                        <li><h6 class="dropdown-header text-uppercase fw-bold">
                                            <i class="bi bi-person-circle"></i> @displayName
                                        </h6></li>
                                        <li><hr class="dropdown-divider"></li>
                                        
                                        <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">
                                            <i class="bi bi-person-gear"></i> Profil
                                        </a></li>
                                        <li><a class="dropdown-item" asp-controller="Orders" asp-action="MyOrders">
                                            <i class="bi bi-receipt"></i> Comenzile mele
                                        </a></li>
                                        <li><a class="dropdown-item" asp-controller="Wishlist" asp-action="Index">
                                            <i class="bi bi-heart"></i> Favorite
                                        </a></li>
                                        <li>
                                            <a class="dropdown-item d-flex justify-content-between align-items-center" asp-controller="Notifications" asp-action="Index">
                                                <span><i class="bi bi-bell"></i> Notificări</span>
                                                @if (unreadNotifications > 0)
                                                {
                                                    <span class="badge bg-danger">@unreadNotifications</span>
                                                }
                                            </a>
                                        </li>

                                        @* ADMIN SECTION - Doar pentru administratori *@
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <li><hr class="dropdown-divider"></li>
                                            <li><h6 class="dropdown-header text-uppercase fw-bold text-warning">
                                                <i class="bi bi-shield-check"></i> Panou Admin
                                            </h6></li>
                                            <li><a class="dropdown-item text-primary fw-semibold" href="#" data-bs-toggle="modal" data-bs-target="#categoriesModal">
                                                <i class="bi bi-tags"></i> Gestionare Categorii
                                            </a></li>
                                            <li><a class="dropdown-item text-primary fw-semibold" href="/Products/Index#pending-products">
                                                <i class="bi bi-clock-history"></i> Produse în Așteptare 
                                                <span id="pendingCountNav" class="badge bg-warning text-dark ms-2">0</span>
                                            </a></li>
                                            <li><a class="dropdown-item text-primary fw-semibold" asp-controller="Admin" asp-action="Users">
                                                <i class="bi bi-people"></i> Gestionare roluri 
                                            </a></li>
                                        }

                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <form class="dropdown-item p-0" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                                                <button type="submit" class="btn btn-link text-decoration-none w-100 text-start text-danger p-2">
                                                    <i class="bi bi-box-arrow-right"></i> Deconectare
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </li>
                            </ul>
                        }
                        else
                        {
                            @* Pentru utilizatori neautentificați - butoane Înregistrare / Autentificare *@
                            <ul class="navbar-nav align-items-center">
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="Identity" asp-page="/Account/Register">
                                        <i class="bi bi-person-plus"></i> <span class="d-none d-lg-inline">Înregistrare</span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link btn btn-outline-light btn-sm ms-2" asp-area="Identity" asp-page="/Account/Login">
                                        <i class="bi bi-box-arrow-in-right"></i> <span class="d-none d-lg-inline">Autentificare</span>
                                    </a>
                                </li>
                            </ul>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container flex-grow-1">
        <main role="main" class="pb-4 flex-grow-1">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-light border-top mt-4 pt-5 pb-4 text-muted footer-disabled">
        <div class="container">
            <div class="row gy-4">
                <div class="col-md-4">
                    <h5 class="fw-bold text-dark"><i class="bi bi-shop-window"></i> Magazin Online</h5>
                    <p class="small text-muted">Magazine Online — produse de calitate, livrare rapidă și suport dedicat. Descoperă selecțiile noastre atent curate.</p>
                    <div class="mt-3">
                        <a href="#" class="text-decoration-none me-2"><i class="bi bi-facebook fs-5"></i></a>
                        <a href="#" class="text-decoration-none me-2"><i class="bi bi-instagram fs-5"></i></a>
                        <a href="#" class="text-decoration-none me-2"><i class="bi bi-twitter fs-5"></i></a>
                    </div>
                </div>

                <div class="col-6 col-md-2">
                    <h6 class="fw-semibold">Servicii Clienți</h6>
                    <ul class="list-unstyled small">
                        <li><a class="text-decoration-none text-muted" href="/Home/Contact">Contact</a></li>
                        <li><a class="text-decoration-none text-muted" href="/Orders/Index">Comenzile mele</a></li>
                        <li><a class="text-decoration-none text-muted" href="/Home/ReturnPolicy">Returnări</a></li>
                        <li><a class="text-decoration-none text-muted" href="/Home/Shipping">Livrare</a></li>
                    </ul>
                </div>

                <div class="col-6 col-md-2">
                    <h6 class="fw-semibold">Info</h6>
                    <ul class="list-unstyled small">
                        <li><a class="text-decoration-none text-muted" href="/Products/Index">Catalog</a></li>
                        <li><a class="text-decoration-none text-muted" href="/Home/About">Despre noi</a></li>
                        <li><a class="text-decoration-none text-muted" href="/Home/Privacy">Politica de confidențialitate</a></li>
                        <li><a class="text-decoration-none text-muted" href="/Home/Terms">Termeni și condiții</a></li>
                    </ul>
                </div>

                <div class="col-md-4">
                    <h6 class="fw-semibold">Abonează-te la newsletter</h6>
                    <p class="small text-muted">Primești oferte și noutăți exclusive.</p>
                    <form class="d-flex" method="post" action="/Home/Subscribe">
                        @Html.AntiForgeryToken()
                        <input type="email" name="email" class="form-control form-control-sm me-2" placeholder="Adresa ta de email" required />
                        <button class="btn btn-primary btn-sm">Abonează-te</button>
                    </form>
                </div>
            </div>

            <hr class="my-4" />

            <div class="d-flex justify-content-between small">
                <div class="text-muted">&copy; @DateTime.Now.Year - Magazin Online. Toate drepturile rezervate.</div>
                <div>
                    <a class="text-muted text-decoration-none me-3" href="/Home/Privacy">Privacy</a>
                    <a class="text-muted text-decoration-none" href="/Home/Terms">Terms</a>
                </div>
            </div>
        </div>
    </footer>

    @* Modal pentru gestionarea categoriilor (doar Admin) *@
    @if (User.IsInRole("Admin"))
    {
        <partial name="_CategoriesModal" />
    }

    <script>
        // expose server-side flags for site.js before loading it
        window.isAdmin = '@(User.IsInRole("Admin").ToString().ToLower())' === 'true';
        window.isAuthenticated = '@(User.Identity?.IsAuthenticated.ToString().ToLower() ?? "false")' === 'true';
    </script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <style>
        /* Disable footer interactivity */
        footer.footer-disabled a,
        footer.footer-disabled button,
        footer.footer-disabled input,
        footer.footer-disabled form {
            pointer-events: none;
            cursor: default;
        }

        /* Smart sticky navbar that follows user scroll position */
        .navbar.sticky-top { 
            position: fixed !important; 
            top: 0;
            left: 0;
            right: 0;
            width: 100%;
            z-index: 1030;
            transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            transform: translateY(0);
        }
        
        /* Hidden state - slides up out of view */
        .navbar-hidden { 
            transform: translateY(-100%) !important;
        }
        
        /* Ensure dropdowns stay on top */
        .navbar .dropdown-menu { 
            z-index: 1040; 
        }
        
        /* Add padding to body to prevent content jump when navbar is fixed */
        body.has-fixed-navbar {
            padding-top: 56px; /* Adjust based on your navbar height */
        }
    </style>
    
    <script>
        // Add class to body for fixed navbar spacing
        document.addEventListener('DOMContentLoaded', function() {
            document.body.classList.add('has-fixed-navbar');
        });
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
