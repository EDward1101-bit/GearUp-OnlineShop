<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OnlineShopProject_dNet</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OnlineShopProject_dNet.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark shadow-lg mb-4">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-shop-window"></i> Magazin Online
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 align-items-center">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door"></i> Acasă
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Products" asp-action="Index">
                                <i class="bi bi-box-seam"></i> Produse
                            </a>
                        </li>
                        @* Dropdown Categorii - pentru toți utilizatorii *@
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="categoriesDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-grid-3x3-gap"></i> Categorii
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="categoriesDropdown" id="categoriesDropdownMenu">
                                <li><a class="dropdown-item" href="/Products/Index"><i class="bi bi-list-ul"></i> Toate produsele</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li class="px-3 py-2 text-muted small"><i class="bi bi-hourglass-split"></i> Se încarcă...</li>
                            </ul>
                        </li>
                        @* Admin - Gestionare Categorii + Produse Pending *@
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle position-relative" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-gear"></i> Administrare
                                    <span id="pendingBadge" class="badge bg-danger badge-notification" style="display: none;">0</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="adminDropdown">
                                    <li>
                                        <h6 class="dropdown-header">
                                            <i class="bi bi-shield-check"></i> Panou Admin
                                        </h6>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#categoriesModal">
                                            <i class="bi bi-tags"></i> Gestionare Categorii
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="/Products/Index#pending-products">
                                            <i class="bi bi-hourglass-split"></i> Produse în Așteptare
                                            <span id="pendingCountNav" class="badge bg-warning text-dark ms-2">0</span>
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        @* Cos + Wishlist *@
                        @await Component.InvokeAsync("NavbarSummary")
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5 py-4" style="background-color: white;">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <p class="mb-0">&copy; 2025 - OnlineShopProject_dNet</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-decoration-none">Privacy</a>
                </div>
            </div>
        </div>
    </footer>

    @* Modal pentru gestionarea categoriilor (doar Admin) *@
    @if (User.IsInRole("Admin"))
    {
        <partial name="_CategoriesModal" />
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <script>
        // 1. Definim variabila o singură dată (Transmitem din C# -> JS)
        const isAdmin = '@(User.IsInRole("Admin").ToString().ToLower())' === 'true';
        document.addEventListener('DOMContentLoaded', function() {
            loadCategoriesDropdown();

            // 2. Activăm logica de Admin doar dacă e cazul
            if (isAdmin) {
                loadPendingCount();
                setInterval(loadPendingCount, 30000);
            }
        });

        function loadCategoriesDropdown() {
            fetch('/Categories/GetAll')
                .then(response => response.json())
                .then(data => {
                    const menu = document.getElementById('categoriesDropdownMenu');
                    if (data && data.length > 0) {
                        let html = '<li><a class="dropdown-item" href="/Products/Index"><i class="bi bi-list-ul"></i> Toate produsele</a></li>';
                        html += '<li><hr class="dropdown-divider"></li>';
                        data.forEach(function(category) {
                            if (category.productCount > 0) {
                                html += '<li><a class="dropdown-item" href="/Products/Index?category=' + category.id + '"><i class="bi bi-tag"></i> ' + category.name + ' <span class="badge bg-secondary ms-2">' + category.productCount + '</span></a></li>';
                            }
                        });
                        menu.innerHTML = html;
                    } else {
                        menu.innerHTML = '<li><a class="dropdown-item" href="/Products/Index"><i class="bi bi-list-ul"></i> Toate produsele</a></li>';
                    }
                })
                .catch(function(error) {
                    console.error('Eroare la încărcarea categoriilor:', error);
                });
        }

        // 3. Funcția există mereu, dar e apelată doar de admini
        function loadPendingCount() {
            fetch('/Products/GetPendingCount')
                .then(function(response) {
                    if (!response.ok) throw new Error('Network response was not ok');
                    return response.json();
                })
                .then(function(data) {
                    const badge = document.getElementById('pendingBadge');
                    const countNav = document.getElementById('pendingCountNav');
                    if (data.count > 0) {
                        if (badge) {
                            badge.textContent = data.count;
                            badge.style.display = 'inline-block';
                        }
                        if (countNav) countNav.textContent = data.count;
                    } else {
                        if (badge) badge.style.display = 'none';
                        if (countNav) countNav.textContent = '0';
                    }
                })
                .catch(function(error) {
                    // Silent catch pentru non-admini sau erori de rețea
                    console.log('Info: Pending count check skipped or failed.');
                });
        }
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
