@model IEnumerable<OnlineShopProject_dNet.Models.Product>
@{
    ViewData["Title"] = "Acas?";
}

<!-- HERO SECTION -->
<section style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 5rem 0; margin-bottom: 3rem;">
    <div class="container">
        <div class="row align-items-center gy-4">
            <div class="col-lg-6">
                <h1 class="display-4 fw-bold mb-3">Descoper? produse de calitate</h1>
                <p class="lead mb-4">Livrare rapid?, pre? corect ?i select? verificat? pentru tine.</p>
                <div class="d-flex gap-3">
                    <a href="/Products/Index" class="btn btn-light btn-lg fw-bold shadow-sm">
                        <i class="bi bi-shop me-2"></i>Magazin
                    </a>
                    <a href="#featured" class="btn btn-outline-light btn-lg fw-bold">
                        <i class="bi bi-arrow-down me-2"></i>Oferte
                    </a>
                </div>
            </div>
            <div class="col-lg-6 text-center">
                <svg style="max-height:250px;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 250">
                    <rect width="300" height="250" fill="rgba(255,255,255,0.1)" rx="15"/>
                    <g transform="translate(100,50)">
                        <rect width="80" height="100" fill="rgba(255,255,255,0.3)" rx="6"/>
                        <circle cx="40" cy="30" r="20" fill="rgba(255,255,255,0.5)"/>
                    </g>
                    <g transform="translate(60,130)">
                        <circle cx="25" cy="25" r="15" fill="rgba(255,255,255,0.2)"/>
                    </g>
                </svg>
            </div>
        </div>
    </div>
</section>

<!-- FEATURED PRODUCTS -->
<section id="featured" class="py-5 bg-light">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="display-6 fw-bold mb-2">Produse Populare</h2>
            <p class="lead text-muted">Selecta noastr? în trending</p>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="row g-4">
                @foreach (var p in Model.Take(8))
                {
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="card border-0 shadow-sm h-100 overflow-hidden">
                            <a href="/Products/Show/@p.Id" class="text-decoration-none text-dark d-block">
                                <div style="height:180px; background:#f5f5f5; display:flex; align-items:center; justify-content:center; position:relative;">
                                    <img src="@p.Image" alt="@p.Title" style="max-height:160px; max-width:85%; object-fit:contain;" />
                                    @if (p.Stock == 0)
                                    {
                                        <div class="position-absolute top-0 start-0 w-100 h-100" style="background:rgba(0,0,0,0.5); display:flex; align-items:center; justify-content:center;">
                                            <span class="badge bg-danger fs-6">Stoc epuizat</span>
                                        </div>
                                    }
                                </div>
                            </a>
                            <div class="card-body p-3">
                                <a href="/Products/Show/@p.Id" class="text-decoration-none text-dark d-block">
                                    <h6 class="fw-semibold mb-2" style="height:2.5rem; overflow:hidden;">@p.Title</h6>
                                </a>
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="text-danger fw-bold fs-5">@p.Price RON</span>
                                    @if (p.Rating.HasValue)
                                    {
                                        <span class="text-warning small"><i class="bi bi-star-fill"></i> @p.Rating.Value.ToString("0.0")</span>
                                    }
                                </div>
                                <div class="d-flex gap-2">
                                    @if (p.Stock > 0)
                                    {
                                        <button class="btn btn-sm btn-primary flex-grow-1 py-2" onclick="addToCartDetailed(@p.Id, 1, this); return false;">
                                            <i class="bi bi-bag-plus"></i> Co?
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-secondary flex-grow-1 py-2" disabled>Indisponibil</button>
                                    }
                                    <button class="btn btn-sm btn-outline-danger py-2 wishlist-btn" data-product-id="@p.Id" style="min-width:44px;">
                                        <i class="bi bi-heart"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="text-center mt-5">
                <a href="/Products/Index" class="btn btn-primary btn-lg px-5 fw-bold">
                    <i class="bi bi-arrow-right me-2"></i>Vezi toate produsele
                </a>
            </div>
        }
        else
        {
            <div class="alert alert-info text-center">
                <i class="bi bi-info-circle me-2"></i>Nu sunt produse disponibile momentan.
            </div>
        }
    </div>
</section>

<!-- INFO SECTION -->
<section class="py-5">
    <div class="container">
        <div class="row g-4 text-center">
            <div class="col-md-4">
                <i class="bi bi-truck fs-1 text-primary mb-3 d-block"></i>
                <h5 class="fw-bold">Livrare Rapid?</h5>
                <p class="text-muted">24-48 ore în toat? ?ara</p>
            </div>
            <div class="col-md-4">
                <i class="bi bi-shield-check fs-1 text-success mb-3 d-block"></i>
                <h5 class="fw-bold">100% Sigur</h5>
                <p class="text-muted">Pl??i securizate ?i garantie</p>
            </div>
            <div class="col-md-4">
                <i class="bi bi-chat-dots fs-1 text-info mb-3 d-block"></i>
                <h5 class="fw-bold">Suport 24/7</h5>
                <p class="text-muted">Echipa mereu disponibil?</p>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.wishlist-btn').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    window.toggleWishlistDetailed(this.getAttribute('data-product-id'), this);
                });
            });
        });
    </script>
}
