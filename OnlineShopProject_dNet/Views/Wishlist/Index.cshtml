@model IEnumerable<OnlineShopProject_dNet.Models.Wishlist>

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-danger">
            <i class="bi bi-heart-fill"></i> Produsele tale favorite
        </h2>

        @* Butonul "Adaugă Tot în Coș" - apare doar dacă ai produse *@
        @if (Model != null && Model.Any())
        {
            <form asp-action="AddAllToCart" method="post">
                <button type="submit" class="btn btn-success fw-bold shadow-sm">
                    <i class="bi bi-cart-plus-fill"></i> Mută tot în Coș
                </button>
            </form>
        }
    </div>

    @* Mesaje de eroare/succes *@
    @if (TempData["message"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="bi bi-info-circle"></i> @TempData["message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    @* Make the card position-relative so stretched-link works *@
                    <div class="card h-100 shadow-sm border-0 position-relative">
                        @* Imagine *@
                        <div class="position-relative" style="height: 250px; overflow: hidden;">
                            @if (item.Product != null)
                            {
                                <a href="/Products/Show/@item.ProductId" class="w-100 h-100 d-block text-decoration-none">
                                    <img src="@(item.Product.Image ?? "/images/default-product.jpg")"
                                         class="card-img-top w-100 h-100"
                                         style="object-fit: cover;"
                                         alt="@item.Product.Title">
                                </a>
                            }
                            else
                            {
                                <img src="/images/default-product.jpg"
                                     class="card-img-top w-100 h-100"
                                     style="object-fit: cover;"
                                     alt="Produs indisponibil">
                            }

                            @* Badge Stoc *@
                            @if (item.Product?.Stock > 0)
                            {
                                <span class="badge bg-success position-absolute top-0 end-0 m-3 shadow">In Stoc</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary position-absolute top-0 end-0 m-3 shadow">Stoc Epuizat</span>
                            }
                        </div>

                        <div class="card-body d-flex flex-column">
                            @if (item.Product != null)
                            {
                                <h5 class="card-title text-truncate">
                                    <a href="/Products/Show/@item.ProductId" class="text-dark text-decoration-none">@item.Product.Title</a>
                                </h5>
                                @* stretched-link covers the whole card body area to improve clickability *@
                                <a href="/Products/Show/@item.ProductId" class="stretched-link" aria-label="Vezi produsul"></a>
                            }
                            else
                            {
                                <h5 class="card-title text-truncate">Produs indisponibil</h5>
                            }

                            <p class="card-text text-muted small text-truncate">@item.Product?.Description</p>

                            <div class="mt-auto d-flex justify-content-between align-items-center">
                                <span class="fs-5 fw-bold text-primary">@item.Product?.Price RON</span>
                            </div>
                        </div>

                        <div class="card-footer bg-white border-top-0 d-flex gap-2 py-3">

                            @* 1. Buton ȘTERGE (Gunoi) *@
                            <form asp-action="Delete" method="post" class="flex-shrink-0">
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <button type="submit" class="btn btn-outline-danger" title="Șterge din favorite">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>

                            @* 2. Buton ADAUGĂ ÎN COȘ *@
                            <form asp-action="AddToCartFromWishlist" method="post" class="flex-grow-1">
                                <input type="hidden" name="productId" value="@item.ProductId" />

                                @if (item.Product != null && item.Product.Stock > 0)
                                {
                                    <button type="submit" class="btn btn-primary w-100 fw-bold">
                                        <i class="bi bi-cart-plus"></i> În Coș
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-secondary w-100" disabled>
                                        Indisponibil
                                    </button>
                                }
                            </form>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        @* EMPTY STATE - Când nu ai favorite *@
        <div class="text-center py-5">
            <div class="mb-4">
                <i class="bi bi-heartbreak display-1 text-muted opacity-25"></i>
            </div>
            <h3 class="fw-bold text-muted">Lista ta de favorite este goală</h3>
            <p class="text-muted mb-4">Salvează produsele care îți plac pentru a le găsi mai ușor.</p>
            <a asp-controller="Products" asp-action="Index" class="btn btn-primary px-5 py-2 fw-bold rounded-pill">
                Vezi Produse
            </a>
        </div>
    }
</div>