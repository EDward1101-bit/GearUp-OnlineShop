@using OnlineShopProject_dNet.Components
@model UserSidebarViewModel

<div class="user-sidebar border-start" style="width: 280px; position: fixed; right: 0; top: 72px; height: calc(100vh - 72px); background: linear-gradient(to bottom, #f8f9fa 0%, #ffffff 100%); border-left: 1px solid #dee2e6; box-shadow: -2px 0 5px rgba(0,0,0,0.1); z-index: 1020; overflow-y: auto; padding: 20px 0;">

    @* HEADER: User Info *@
    <div class="user-header px-3 pb-3 border-bottom">
        <div class="d-flex align-items-center gap-2 mb-3">
            <div class="avatar-circle bg-primary text-white" style="width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold;">
                @if (!string.IsNullOrEmpty(Model.FirstName))
                {
                    @Model.FirstName[0]
                }
                else
                {
                    @Model.UserName[0]
                }
            </div>
            <div class="flex-grow-1">
                <div class="fw-bold text-dark">@(string.IsNullOrEmpty(Model.FirstName) ? Model.UserName : $"{Model.FirstName} {Model.LastName}")</div>
                <small class="text-muted">@Model.Email</small>
            </div>
        </div>
    </div>

    @* MENU: User Actions *@
    <div class="user-menu px-0 py-2">
        <a href="/Orders/MyOrders" class="sidebar-link d-flex align-items-center gap-2 px-3 py-2 text-decoration-none text-dark" style="transition: background 0.2s;">
            <i class="bi bi-box-seam fs-5"></i>
            <span>Comenzile mele</span>
            <span class="badge bg-warning text-dark ms-auto" style="font-size: 0.75rem;">New</span>
        </a>

        <a href="/Profile/Index" class="sidebar-link d-flex align-items-center gap-2 px-3 py-2 text-decoration-none text-dark" style="transition: background 0.2s;">
            <i class="bi bi-gear fs-5"></i>
            <span>Profil</span>
        </a>

        <a href="/Identity/Account/ChangePassword" class="sidebar-link d-flex align-items-center gap-2 px-3 py-2 text-decoration-none text-dark" style="transition: background 0.2s;">
            <i class="bi bi-key fs-5"></i>
            <span>Schimbă parola</span>
        </a>
    </div>

    @* ADMIN SECTION *@
    @if (Model.IsAdmin)
    {
        <div class="admin-section border-top mt-3 pt-3">
            <div class="px-3 mb-2">
                <h6 class="text-dark fw-bold mb-3">
                    <i class="bi bi-shield-check"></i> Admin Panel
                </h6>
            </div>

            @* Admin Stats Cards *@
            <div class="admin-stats px-3 mb-3">
                <div class="stat-card bg-info bg-opacity-10 rounded p-2 mb-2" style="border-left: 3px solid #0dcaf0;">
                    <small class="text-muted d-block">Utilizatori</small>
                    <div class="fw-bold text-info">@Model.TotalUsersCount</div>
                </div>

                <div class="stat-card bg-warning bg-opacity-10 rounded p-2 mb-2" style="border-left: 3px solid #ffc107;">
                    <small class="text-muted d-block">Produse Aprobate</small>
                    <div class="fw-bold text-warning">@Model.TotalProductsCount</div>
                </div>

                <div class="stat-card bg-danger bg-opacity-10 rounded p-2 mb-2" style="border-left: 3px solid #dc3545;">
                    <small class="text-muted d-block">În asteptare</small>
                    <div class="fw-bold text-danger">@Model.PendingProductsCount</div>
                </div>

                <div class="stat-card bg-success bg-opacity-10 rounded p-2" style="border-left: 3px solid #198754;">
                    <small class="text-muted d-block">Comenzi</small>
                    <div class="fw-bold text-success">@Model.TotalOrdersCount</div>
                </div>
            </div>

            @* Admin Menu *@
            <div class="admin-menu">
                <a href="/Admin/Dashboard" class="sidebar-link d-flex align-items-center gap-2 px-3 py-2 text-decoration-none text-dark" style="transition: background 0.2s;">
                    <i class="bi bi-graph-up fs-5"></i>
                    <span>Dashboard</span>
                </a>

                <a href="/Categories/Index" class="sidebar-link d-flex align-items-center gap-2 px-3 py-2 text-decoration-none text-dark" style="transition: background 0.2s;" data-bs-toggle="modal" data-bs-target="#categoriesModal">
                    <i class="bi bi-grid-3x3-gap fs-5"></i>
                    <span>Categorii</span>
                </a>

                <a href="/Products/Index#pending-products" class="sidebar-link d-flex align-items-center gap-2 px-3 py-2 text-decoration-none text-dark" style="transition: background 0.2s;">
                    <i class="bi bi-hourglass-split fs-5"></i>
                    <span>În așteptare</span>
                    @if (Model.PendingProductsCount > 0)
                    {
                        <span class="badge bg-danger ms-auto">@Model.PendingProductsCount</span>
                    }
                </a>

                <a href="/Admin/Users" class="sidebar-link d-flex align-items-center gap-2 px-3 py-2 text-decoration-none text-dark" style="transition: background 0.2s;">
                    <i class="bi bi-people fs-5"></i>
                    <span>Utilizatori</span>
                </a>
            </div>
        </div>
    }

    @* LOGOUT BUTTON *@
    <div class="logout-section border-top mt-3 pt-3 px-3">
        <form method="post" action="/Identity/Account/Logout" class="w-100">
            <button type="submit" class="btn btn-outline-danger w-100 btn-sm">
                <i class="bi bi-door-left"></i> Delogare
            </button>
        </form>
    </div>
</div>

<style>
    .sidebar-link {
        border-left: 3px solid transparent;
        margin: 0 10px;
        border-radius: 4px;
        position: relative;
    }

    .sidebar-link:hover {
        background-color: rgba(108, 117, 125, 0.1);
        border-left-color: #0dcaf0;
    }

    .stat-card {
        cursor: default;
    }

    @@media (max-width: 1200px) {
        .user-sidebar {
            width: 250px;
        }
    }

    @@media (max-width: 992px) {
        .user-sidebar {
            position: relative;
            right: auto;
            top: auto;
            height: auto;
            width: 100%;
            border-left: none;
            border-top: 1px solid #dee2e6;
            box-shadow: none;
            margin-top: 20px;
        }

        body {
            margin-right: 0 !important;
        }
    }
</style>
