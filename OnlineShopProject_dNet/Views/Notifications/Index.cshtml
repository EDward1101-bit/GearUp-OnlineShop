@model IEnumerable<OnlineShopProject_dNet.Models.Notification>
@{
    ViewBag.Title = "Notificarile mele";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Notificările mele</h2>
        @if (Model.Any())
        {
            <form asp-action="MarkAll" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-secondary btn-sm">Marchează tot ca citit</button>
            </form>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">Nu aveți notificări.</div>
    }
    else
    {
        <div class="list-group shadow-sm">
            @foreach (var n in Model)
            {
                <div class="list-group-item d-flex justify-content-between align-items-start @(n.IsRead ? "" : "bg-light")">
                    <div class="me-3">
                        <div class="fw-semibold">@n.Message</div>
                        <small class="text-muted">@n.CreatedAt.ToString("dd MMM yyyy HH:mm")</small>
                    </div>
                    <div>
                        @if (!n.IsRead)
                        {
                            <form asp-action="MarkRead" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@n.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-primary">Marchează citit</button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>
