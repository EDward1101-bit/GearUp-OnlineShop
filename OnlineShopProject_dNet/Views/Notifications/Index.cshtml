@model IEnumerable<OnlineShopProject_dNet.Models.Notification>
@{
    ViewBag.Title = "Notificarile mele";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Notificările mele</h2>
        @if (Model.Any())
        {
            <form asp-action="MarkAll" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-secondary btn-sm">Marchează tot ca citit</button>
            </form>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">Nu aveți notificări.</div>
    }
    else
    {
        <div class="list-group shadow-sm">
            @foreach (var n in Model)
            {
                <div class="list-group-item @(n.IsRead ? "" : "bg-light border-start border-primary border-3")">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="me-3 flex-grow-1">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                @if (n.Type == "product_approved")
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle"></i> Aprobare</span>
                                }
                                else if (n.Type == "product_rejected")
                                {
                                    <span class="badge bg-danger"><i class="bi bi-x-circle"></i> Respingere</span>
                                }
                                else if (n.Type == "role")
                                {
                                    <span class="badge bg-info"><i class="bi bi-person-badge"></i> Rol</span>
                                }
                                @if (!n.IsRead)
                                {
                                    <span class="badge bg-primary">Nou</span>
                                }
                            </div>
                            <div class="fw-semibold mb-1">@n.Message</div>
                            @if (!string.IsNullOrWhiteSpace(n.FeedbackMessage))
                            {
                                <div class="alert alert-light border mb-2 mt-2" style="background-color: #f8f9fa;">
                                    <strong><i class="bi bi-chat-quote"></i> Mesaj de la administrator:</strong>
                                    <p class="mb-0 mt-2">@n.FeedbackMessage</p>
                                </div>
                            }
                            <small class="text-muted"><i class="bi bi-clock"></i> @n.CreatedAt.ToString("dd MMM yyyy HH:mm")</small>
                            @if (n.ProductId.HasValue)
                            {
                                <div class="mt-2">
                                    <a href="/Products/Show/@n.ProductId" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-box-seam"></i> Vezi Produsul
                                    </a>
                                </div>
                            }
                        </div>
                        <div>
                            @if (!n.IsRead)
                            {
                                <form asp-action="MarkRead" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@n.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-check2"></i> Marchează citit
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
