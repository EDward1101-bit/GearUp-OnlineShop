@{
    ViewBag.Title = "Edit";
}

<h2>Edit review</h2>
<br />

<form method="post" action="/Reviews/Edit/@ViewBag.Review.Id">
    @Html.AntiForgeryToken()
    <label>Continut review</label>
    <br />

    <textarea name="Content">@ViewBag.Review.Content</textarea>
    <br />

    <button class="btn btn-primary" type="submit">Editeaza review</button>

</form>