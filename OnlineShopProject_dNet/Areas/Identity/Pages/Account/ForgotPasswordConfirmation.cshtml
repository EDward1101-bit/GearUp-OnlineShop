@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Confirmare Recuperare Parol?";
}

<div class="forgot-password-confirmation-page min-vh-100 d-flex align-items-center" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card shadow-lg border-0 rounded-4">
                    <div class="card-body p-5 text-center">
                        <div class="mb-4">
                            <i class="bi bi-envelope-check-fill text-success" style="font-size: 5rem;"></i>
                        </div>
                        <h2 class="fw-bold text-dark mb-3">Email trimis!</h2>
                        <p class="text-muted mb-4">
                            Am trimis un email cu instructiuni pentru resetarea parolei. Te rugam sa verifici inbox-ul si spam-ul.
                        </p>

                        <div class="alert alert-info rounded-3 border-0 mb-4" style="background-color: #e3f2fd;">
                            <i class="bi bi-info-circle-fill text-primary me-2"></i>
                            <small>Daca nu primesti email-ul in 5 minute, verifica adresa introdusa sau incearca din nou.</small>
                        </div>

                        <a asp-page="./Login" class="btn btn-primary btn-lg w-100 rounded-3 fw-semibold">
                            <i class="bi bi-arrow-left me-2"></i> Inapoi la Autentificare
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
