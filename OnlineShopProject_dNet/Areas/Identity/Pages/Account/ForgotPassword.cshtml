@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Ai uitat parola?";
}

<div class="forgot-password-page min-vh-100 d-flex align-items-center" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card shadow-lg border-0 rounded-4">
                    <div class="card-body p-5">
                            <div class="text-center mb-4">
                                <div class="mb-3">
                                    <i class="bi bi-question-circle text-primary" style="font-size: 4rem;"></i>
                                </div>
                                <h2 class="fw-bold text-dark">Ai uitat parola?</h2>
                                <p class="text-muted">Nu-ti face griji! Introdu emailul tau si iti vom trimite un link pentru resetarea parolei.</p>
                            </div>

                        <form method="post">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>
                            
                            <div class="mb-4">
                                <label asp-for="Input.Email" class="form-label fw-semibold">
                                    <i class="bi bi-envelope me-1 text-primary"></i> Adresa de email
                                </label>
                                <input asp-for="Input.Email" class="form-control form-control-lg rounded-3" 
                                       placeholder="exemplu@email.com" autocomplete="username" />
                                <span asp-validation-for="Input.Email" class="text-danger small"></span>
                            </div>

                            <button type="submit" class="btn btn-primary btn-lg w-100 rounded-3 fw-semibold mb-3">
                                <i class="bi bi-send me-2"></i> Trimite link de resetare
                            </button>

                            <div class="text-center">
                                <a asp-page="./Login" class="text-decoration-none">
                                    <i class="bi bi-arrow-left me-1"></i> Inapoi la autentificare
                                </a>
                            </div>
                        </form>

                        <hr class="my-4">

                        <div class="alert alert-info rounded-3 border-0 mb-0" style="background-color: #e3f2fd;">
                            <i class="bi bi-info-circle-fill text-primary me-2"></i>
                            <small>Vei primi un email cu instructiuni pentru resetarea parolei in cateva minute.</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
