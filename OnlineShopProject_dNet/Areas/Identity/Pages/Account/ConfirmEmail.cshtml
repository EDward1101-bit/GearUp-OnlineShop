@page
@model ConfirmEmailModel
@{
    ViewData["Title"] = "Confirmare Email";
}

<div class="confirm-email-page min-vh-100 d-flex align-items-center" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card shadow-lg border-0 rounded-4">
                    <div class="card-body p-5 text-center">
                        @if (Model.StatusMessage == "success")
                        {
                            <div class="mb-4">
                                <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
                            </div>
                            <h2 class="fw-bold text-dark mb-3">Email confirmat!</h2>
                            <p class="text-muted mb-4">
                                Multumim pentru confirmarea adresei de email. Contul tau este acum activ si poti incepe sa cumperi.
                            </p>

                            <div class="alert alert-success rounded-3 border-0 mb-4">
                                <i class="bi bi-shield-check me-2"></i>
                                <strong>Succes!</strong> Contul tau a fost verificat cu succes.
                            </div>

                            <a asp-page="./Login" class="btn btn-primary btn-lg w-100 rounded-3 fw-semibold">
                                <i class="bi bi-box-arrow-in-right me-2"></i> Autentifica-te acum
                            </a>
                        }
                        else
                        {
                            <div class="mb-4">
                                <i class="bi bi-x-circle-fill text-danger" style="font-size: 5rem;"></i>
                            </div>
                            <h2 class="fw-bold text-dark mb-3">Eroare la confirmare</h2>
                            <p class="text-muted mb-4">
                                A aparut o eroare la confirmarea adresei de email. Link-ul poate fi expirat sau invalid.
                            </p>

                            <div class="alert alert-danger rounded-3 border-0 mb-4">
                                <i class="bi bi-exclamation-triangle me-2"></i>
                                <strong>Eroare!</strong> Nu am putut confirma adresa de email.
                            </div>

                            <div class="d-grid gap-2">
                                <a asp-page="./Register" class="btn btn-outline-primary btn-lg rounded-3">
                                    <i class="bi bi-person-plus me-2"></i> Inregistreaza-te din nou
                                </a>
                                <a asp-page="./Login" class="btn btn-primary btn-lg rounded-3 fw-semibold">
                                    <i class="bi bi-box-arrow-in-right me-2"></i> Inapoi la Autentificare
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
