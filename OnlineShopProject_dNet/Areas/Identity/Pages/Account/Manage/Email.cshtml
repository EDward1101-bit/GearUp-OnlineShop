@page
@model EmailModel
@{
    ViewData["Title"] = "Gestionare Email";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            @* Header Section *@
            <div class="card border-0 shadow-sm mb-4" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center text-white">
                        <div class="avatar-circle bg-white text-primary me-3" 
                             style="width: 80px; height: 80px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2rem;">
                            <i class="bi bi-envelope-fill"></i>
                        </div>
                        <div>
                            <h2 class="mb-1 fw-bold">Gestionare email</h2>
                            <p class="mb-0 opacity-75">Schimba sau verifica adresa de email</p>
                        </div>
                    </div>
                </div>
            </div>

            @* Quick Navigation Tabs *@
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-3">
                    <div class="d-flex flex-wrap gap-2 justify-content-center">
                        <a href="/Identity/Account/Manage" class="btn btn-outline-primary">
                            <i class="bi bi-person-circle me-1"></i> Profil
                        </a>
                        <a href="/Identity/Account/Manage/Email" class="btn btn-primary">
                            <i class="bi bi-envelope me-1"></i> Email
                        </a>
                        <a href="/Identity/Account/Manage/ChangePassword" class="btn btn-outline-primary">
                            <i class="bi bi-key me-1"></i> Schimba parola
                        </a>
                        <a href="/Identity/Account/Manage/TwoFactorAuthentication" class="btn btn-outline-primary">
                            <i class="bi bi-shield-lock me-1"></i> 2FA
                        </a>
                        <a href="/Identity/Account/Manage/PersonalData" class="btn btn-outline-primary">
                            <i class="bi bi-file-person me-1"></i> Date personale
                        </a>
                    </div>
                    <div class="d-flex flex-wrap gap-2 justify-content-center mt-2">
                        <a href="/Orders/MyOrders" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-box-seam me-1"></i> Comenzile mele
                        </a>
                        <a href="/Wishlist/Index" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-heart me-1"></i> Favorite
                        </a>
                        <a href="/Notifications/Index" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-bell me-1"></i> Notificari
                        </a>
                        <a href="/Products/Index" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-bag me-1"></i> Magazin
                        </a>
                    </div>
                </div>
            </div>

            @* Main Content *@
            <div>
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <h4 class="card-title mb-4 fw-bold">
                            <i class="bi bi-envelope-at text-primary"></i> Emailul tau
                        </h4>

                        @if (TempData["StatusMessage"] != null)
                        {
                            <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
                                <i class="bi bi-check-circle-fill me-2"></i> @TempData["StatusMessage"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        }

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Email curent</label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-light">
                                    <i class="bi bi-envelope"></i>
                                </span>
                                <input type="text" class="form-control rounded-end" value="@Model.Email" disabled />
                            </div>
                            @if (Model.IsEmailConfirmed)
                            {
                                <small class="text-success d-block mt-2">
                                    <i class="bi bi-check-circle-fill"></i> Emailul tau este verificat
                                </small>
                            }
                            else
                            {
                                <small class="text-warning d-block mt-2">
                                    <i class="bi bi-exclamation-triangle-fill"></i> Emailul tau nu este verificat
                                </small>
                            }
                        </div>

                        @if (!Model.IsEmailConfirmed)
                        {
                            <form method="post" asp-page-handler="SendVerificationEmail" class="mb-4">
                                <div class="alert alert-warning rounded-3">
                                    <i class="bi bi-info-circle-fill me-2"></i>
                                    <strong>Atentie!</strong> Emailul tau nu este verificat.
                                </div>
                                <button type="submit" class="btn btn-warning">
                                    <i class="bi bi-send me-2"></i> Retrimite emailul de verificare
                                </button>
                            </form>
                        }

                        <hr class="my-4">

                        <h5 class="mb-3 fw-bold">Schimba emailul</h5>
                        <form method="post" asp-page-handler="ChangeEmail">
                            <div asp-validation-summary="All" class="alert alert-danger rounded-3" role="alert"></div>

                            <div class="mb-4">
                                <label asp-for="Input.NewEmail" class="form-label fw-semibold">
                                    <i class="bi bi-envelope-plus me-1 text-primary"></i> Email nou
                                </label>
                                <input asp-for="Input.NewEmail" class="form-control form-control-lg rounded-3" 
                                       placeholder="email.nou@exemplu.com" />
                                <span asp-validation-for="Input.NewEmail" class="text-danger small"></span>
                                <small class="text-muted d-block mt-1">
                                    <i class="bi bi-info-circle"></i> Vei primi un email de confirmare la noua adresa.
                                </small>
                            </div>

                            <div class="d-flex justify-content-center">
                                <button type="submit" class="btn btn-primary btn-lg px-4 rounded-3">
                                    <i class="bi bi-check-circle me-2"></i> Schimba emailul
                                </button>
                            </div>
                        </form>

                        <hr class="my-4">

                        <div class="alert alert-info rounded-3 border-0" style="background-color: #e3f2fd;">
                            <i class="bi bi-shield-check text-primary me-2"></i>
                            <strong>Securitate:</strong>
                            <ul class="mb-0 mt-2 small">
                                <li>Vei primi un email de confirmare la noua adresa.</li>
                                <li>Emailul actual ramane activ pana la confirmarea celui nou.</li>
                                <li>Verifica si folderele Spam/Junk daca nu gasesti emailul.</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
