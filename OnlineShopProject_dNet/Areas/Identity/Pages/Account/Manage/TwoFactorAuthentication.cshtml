@page
@model TwoFactorAuthenticationModel
@{
    ViewData["Title"] = "Autentificare in Doi Pasi";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            @* Header Section *@
            <div class="card border-0 shadow-sm mb-4" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center text-white">
                        <div class="avatar-circle bg-white text-primary me-3" 
                             style="width: 80px; height: 80px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2rem;">
                            <i class="bi bi-shield-lock-fill"></i>
                        </div>
                        <div>
                            <h2 class="mb-1 fw-bold">Autentificare in Doi Pasi (2FA)</h2>
                            <p class="mb-0 opacity-75">Protejeaza-ti contul cu un nivel suplimentar de securitate</p>
                        </div>
                    </div>
                </div>
            </div>

            @* Quick Navigation Tabs *@
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-3">
                    <div class="d-flex flex-wrap gap-2 justify-content-center">
                        <a href="/Identity/Account/Manage" class="btn btn-outline-primary">
                            <i class="bi bi-person-circle me-1"></i> Profil
                        </a>
                        <a href="/Identity/Account/Manage/Email" class="btn btn-outline-primary">
                            <i class="bi bi-envelope me-1"></i> Email
                        </a>
                        <a href="/Identity/Account/Manage/ChangePassword" class="btn btn-outline-primary">
                            <i class="bi bi-key me-1"></i> Schimba Parola
                        </a>
                        <a href="/Identity/Account/Manage/TwoFactorAuthentication" class="btn btn-primary">
                            <i class="bi bi-shield-lock me-1"></i> 2FA
                        </a>
                        <a href="/Identity/Account/Manage/PersonalData" class="btn btn-outline-primary">
                            <i class="bi bi-file-person me-1"></i> Date Personale
                        </a>
                    </div>
                    <div class="d-flex flex-wrap gap-2 justify-content-center mt-2">
                        <a href="/Orders/MyOrders" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-box-seam me-1"></i> Comenzile Mele
                        </a>
                        <a href="/Wishlist/Index" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-heart me-1"></i> Favorite
                        </a>
                        <a href="/Notifications/Index" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-bell me-1"></i> Notificari
                        </a>
                    </div>
                </div>
            </div>

            @* Main Content *@
            <div>
                @if (TempData["StatusMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i> @TempData["StatusMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body p-4">
                        <h4 class="card-title mb-4 fw-bold">
                            <i class="bi bi-shield-check text-primary"></i> Status 2FA
                        </h4>

                        @if (Model.Is2faEnabled)
                        {
                            <div class="alert alert-success rounded-3">
                                <i class="bi bi-check-circle-fill me-2"></i>
                                <strong>Autentificarea in doi pasi este ACTIVATA</strong>
                            </div>

                            @if (Model.RecoveryCodesLeft == 0)
                            {
                                <div class="alert alert-danger rounded-3">
                                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                    <strong>Nu mai ai coduri de recuperare!</strong>
                                    <p class="mb-0 mt-2">Trebuie sa <a asp-page="./GenerateRecoveryCodes">generezi un nou set de coduri de recuperare</a> inainte sa te poti autentifica cu un cod de recuperare.</p>
                                </div>
                            }
                            else if (Model.RecoveryCodesLeft == 1)
                            {
                                <div class="alert alert-warning rounded-3">
                                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                    <strong>Mai ai 1 cod de recuperare ramas.</strong>
                                    <p class="mb-0 mt-2">Poti sa <a asp-page="./GenerateRecoveryCodes">generezi un nou set de coduri de recuperare</a>.</p>
                                </div>
                            }
                            else if (Model.RecoveryCodesLeft <= 3)
                            {
                                <div class="alert alert-warning rounded-3">
                                    <i class="bi bi-info-circle-fill me-2"></i>
                                    <strong>Mai ai @Model.RecoveryCodesLeft coduri de recuperare ramase.</strong>
                                    <p class="mb-0 mt-2">Ar trebui sa <a asp-page="./GenerateRecoveryCodes">generezi un nou set de coduri de recuperare</a>.</p>
                                </div>
                            }

                            @if (Model.IsMachineRemembered)
                            {
                                <form method="post" style="display: inline-block">
                                    <button type="submit" class="btn btn-outline-primary">
                                        <i class="bi bi-x-circle me-2"></i> Uita acest browser
                                    </button>
                                </form>
                            }

                            <div class="mt-3">
                                <a asp-page="./Disable2fa" class="btn btn-danger">
                                    <i class="bi bi-shield-x me-2"></i> Dezactiveaza 2FA
                                </a>
                                <a asp-page="./GenerateRecoveryCodes" class="btn btn-outline-secondary">
                                    <i class="bi bi-arrow-clockwise me-2"></i> Reseteaza codurile de recuperare
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning rounded-3">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                <strong>Autentificarea in doi pasi este DEZACTIVATA</strong>
                            </div>

                            <p class="text-muted mb-4">
                                Activarea autentificarii in doi pasi adauga un nivel suplimentar de securitate contului tau.
                            </p>
                        }

                        @if (!Model.HasAuthenticator)
                        {
                            <a asp-page="./EnableAuthenticator" class="btn btn-primary btn-lg">
                                <i class="bi bi-shield-plus me-2"></i> Adauga aplicatie de autentificare
                            </a>
                        }
                        else
                        {
                            <a asp-page="./EnableAuthenticator" class="btn btn-outline-primary">
                                <i class="bi bi-gear me-2"></i> Configureaza aplicatia de autentificare
                            </a>
                            <a asp-page="./ResetAuthenticator" class="btn btn-outline-danger">
                                <i class="bi bi-arrow-counterclockwise me-2"></i> Reseteaza aplicatia de autentificare
                            </a>
                        }

                        <hr class="my-4">

                        <div class="alert alert-info rounded-3 border-0" style="background-color: #e3f2fd;">
                            <i class="bi bi-info-circle-fill text-primary me-2"></i>
                            <strong>Ce este 2FA?</strong>
                            <p class="mb-0 mt-2 small">
                                Autentificarea in doi pasi (2FA) adauga un nivel suplimentar de securitate contului tau. 
                                Chiar daca cineva afla parola ta, nu va putea accesa contul fara al doilea factor de autentificare.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
