@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Schimba parola";
}

<div class="container py-5">
<div class="row justify-content-center">
    <div class="col-lg-8">
        @* Header Section *@
        <div class="card border-0 shadow-sm mb-4" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
            <div class="card-body p-4">
                <div class="d-flex align-items-center text-white">
                    <div class="avatar-circle bg-white text-primary me-3" 
                         style="width: 80px; height: 80px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2rem;">
                        <i class="bi bi-key-fill"></i>
                    </div>
                    <div>
                        <h2 class="mb-1 fw-bold">Securitate cont</h2>
                        <p class="mb-0 opacity-75">Schimba parola contului tau</p>
                    </div>
                </div>
            </div>
        </div>

            @* Quick Navigation Tabs *@
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-3">
                    <div class="d-flex flex-wrap gap-2 justify-content-center">
                        <a href="/Identity/Account/Manage" class="btn btn-outline-primary">
                            <i class="bi bi-person-circle me-1"></i> Profil
                        </a>
                        <a href="/Identity/Account/Manage/Email" class="btn btn-outline-primary">
                            <i class="bi bi-envelope me-1"></i> Email
                        </a>
                        <a href="/Identity/Account/Manage/ChangePassword" class="btn btn-primary">
                            <i class="bi bi-key me-1"></i> Schimba parola
                        </a>
                        <a href="/Identity/Account/Manage/TwoFactorAuthentication" class="btn btn-outline-primary">
                            <i class="bi bi-shield-lock me-1"></i> 2FA
                        </a>
                        <a href="/Identity/Account/Manage/PersonalData" class="btn btn-outline-primary">
                            <i class="bi bi-file-person me-1"></i> Date personale
                        </a>
                    </div>
                    <div class="d-flex flex-wrap gap-2 justify-content-center mt-2">
                        <a href="/Orders/MyOrders" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-box-seam me-1"></i> Comenzile mele
                        </a>
                        <a href="/Wishlist/Index" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-heart me-1"></i> Favorite
                        </a>
                        <a href="/Notifications/Index" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-bell me-1"></i> Notificari
                        </a>
                        <a href="/Products/Index" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-bag me-1"></i> Magazin
                        </a>
                    </div>
                </div>
            </div>

        @* Main Content *@
            <div>
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <h4 class="card-title mb-4 fw-bold">
                            <i class="bi bi-shield-lock text-primary"></i> Schimba parola
                        </h4>

                        @if (TempData["StatusMessage"] != null)
                        {
                            <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
                                <i class="bi bi-check-circle-fill me-2"></i> @TempData["StatusMessage"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        }

                        <form id="change-password-form" method="post">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>

                            <div class="mb-4">
                                <label asp-for="Input.OldPassword" class="form-label fw-semibold">
                                    <i class="bi bi-lock me-1 text-primary"></i> Parola actuala
                                </label>
                                <div class="position-relative">
                                    <input asp-for="Input.OldPassword" type="password" class="form-control form-control-lg rounded-3 pe-5" 
                                           placeholder="Introdu parola actuala" id="oldPassword" autocomplete="current-password" />
                                    <button type="button" class="btn btn-link position-absolute end-0 top-50 translate-middle-y text-muted" 
                                            onclick="togglePasswordVisibility('oldPassword', 'toggleIcon1')" style="z-index: 10;">
                                        <i class="bi bi-eye" id="toggleIcon1"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="Input.OldPassword" class="text-danger small"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="Input.NewPassword" class="form-label fw-semibold">
                                    <i class="bi bi-key me-1 text-primary"></i> Parola noua
                                </label>
                                <div class="position-relative">
                                    <input asp-for="Input.NewPassword" type="password" class="form-control form-control-lg rounded-3 pe-5" 
                                           placeholder="Minimum 6 caractere" id="newPassword" autocomplete="new-password" />
                                    <button type="button" class="btn btn-link position-absolute end-0 top-50 translate-middle-y text-muted" 
                                            onclick="togglePasswordVisibility('newPassword', 'toggleIcon2')" style="z-index: 10;">
                                        <i class="bi bi-eye" id="toggleIcon2"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="Input.ConfirmPassword" class="form-label fw-semibold">
                                    <i class="bi bi-check-circle me-1 text-primary"></i> Confirma parola noua
                                </label>
                                <div class="position-relative">
                                    <input asp-for="Input.ConfirmPassword" type="password" class="form-control form-control-lg rounded-3 pe-5" 
                                           placeholder="Rescrie parola noua" id="confirmPassword" autocomplete="new-password" />
                                    <button type="button" class="btn btn-link position-absolute end-0 top-50 translate-middle-y text-muted" 
                                            onclick="togglePasswordVisibility('confirmPassword', 'toggleIcon3')" style="z-index: 10;">
                                        <i class="bi bi-eye" id="toggleIcon3"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                            </div>

                            <div class="alert alert-info rounded-3 border-0" style="background-color: #e3f2fd;">
                                <i class="bi bi-info-circle-fill text-primary me-2"></i>
                                <strong>Sfaturi pentru o parola sigura:</strong>
                                <ul class="mb-0 mt-2 small">
                                    <li>Minimum 6 caractere (se recomanda 12+)</li>
                                    <li>Combinatie de litere mari si mici</li>
                                    <li>Include cifre si caractere speciale</li>
                                    <li>Evita cuvinte comune sau informatii personale</li>
                                </ul>
                            </div>

                            <hr class="my-4">

                            <div class="d-flex justify-content-center">
                                <button type="submit" class="btn btn-primary btn-lg rounded-3 px-5">
                                    <i class="bi bi-check-circle me-2"></i> Actualizeaza parola
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function togglePasswordVisibility(inputId, iconId) {
        const passwordInput = document.getElementById(inputId);
        const toggleIcon = document.getElementById(iconId);
        
        if (passwordInput.type === 'password') {
            passwordInput.type = 'text';
            toggleIcon.classList.remove('bi-eye');
            toggleIcon.classList.add('bi-eye-slash');
        } else {
            passwordInput.type = 'password';
            toggleIcon.classList.remove('bi-eye-slash');
            toggleIcon.classList.add('bi-eye');
        }
    }
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
