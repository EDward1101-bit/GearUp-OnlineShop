@page
@model LogoutModel
@{
    ViewData["Title"] = "Deconectare";
}

<div class="logout-page min-vh-100 d-flex align-items-center" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card shadow-lg border-0 rounded-4">
                    <div class="card-body p-5 text-center">
                        <div class="mb-4">
                            <i class="bi bi-box-arrow-right text-warning" style="font-size: 5rem;"></i>
                        </div>
                        <h2 class="fw-bold text-dark mb-3">Ai fost deconectat</h2>
                        <p class="text-muted mb-4">
                            Te-ai deconectat cu succes din contul t?u. Î?i mul?umim pentru vizit?!
                        </p>

                        <a asp-page="./Login" class="btn btn-primary btn-lg w-100 rounded-3 fw-semibold mb-3">
                            <i class="bi bi-box-arrow-in-right me-2"></i> Autentific?-te din nou
                        </a>

                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-lg w-100 rounded-3">
                            <i class="bi bi-house-door me-2"></i> Pagina principal?
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
